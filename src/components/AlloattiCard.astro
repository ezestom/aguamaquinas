---
import Icon from './Icon.astro';
---
<alloatti-card class="alloatti-card">
  <div class="alloatti-media">
    <video muted loop playsinline preload="none" poster="/alloatti-poster.webp" width="440" height="330" aria-hidden="true"></video>
    <button type="button" class="alloatti-playback" aria-label="Reproducir video de Alloatti" hidden>
      <span data-play><Icon name="play" size={16} /></span>
      <span data-pause hidden><Icon name="pause" size={16} /></span>
    </button>
    <a href="https://www.alloatti.com/maquina-para-bidones-retornables?utm_source=aguamaquinas&utm_medium=referido">
      <img src="/alloatti-logo.webp" alt="Alloatti" width="360" height="101" loading="lazy" />
      <span>Ver equipos nuevos <Icon name="external" size={14} /></span>
    </a>
  </div>
</alloatti-card>

<script>
  class AlloattiCard extends HTMLElement {
    private observer?: IntersectionObserver;
    private listeners?: AbortController;

    connectedCallback() {
      const video = this.querySelector('video');
      const button = this.querySelector('button');
      const playIcon = button?.querySelector<HTMLElement>('[data-play]');
      const pauseIcon = button?.querySelector<HTMLElement>('[data-pause]');
      if (!video || !button || !playIcon || !pauseIcon) return;

      this.listeners = new AbortController();
      const { signal } = this.listeners;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let wantsPlayback = !motion.matches;
      let visible = false;
      const play = () => {
        if (!video.getAttribute('src')) video.src = '/alloatti-loop.mp4';
        void video.play().catch(() => {});
      };
      const sync = () => {
        if (visible && wantsPlayback && !document.hidden) play();
        else video.pause();
      };
      const updateButton = () => {
        playIcon.hidden = !video.paused;
        pauseIcon.hidden = video.paused;
        button.setAttribute('aria-label', video.paused ? 'Reproducir video de Alloatti' : 'Pausar video de Alloatti');
      };

      video.addEventListener('play', updateButton, { signal });
      video.addEventListener('pause', updateButton, { signal });
      button.addEventListener('click', () => {
        wantsPlayback = video.paused;
        if (wantsPlayback) play();
        else video.pause();
      }, { signal });
      motion.addEventListener('change', () => { wantsPlayback = !motion.matches; sync(); }, { signal });
      document.addEventListener('visibilitychange', sync, { signal });
      this.observer = new IntersectionObserver(([entry]) => {
        visible = entry.intersectionRatio >= 0.25;
        sync();
      }, { threshold: 0.25 });
      this.observer.observe(video);
      button.hidden = false;
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.listeners?.abort();
      this.querySelector('video')?.pause();
    }
  }

  customElements.define('alloatti-card', AlloattiCard);
</script>

<style>
  .alloatti-card { display: block; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .alloatti-media { position: relative; background: var(--media-backdrop); }
  .alloatti-media::before { content: ''; position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, #000c); pointer-events: none; }
  video { display: block; width: 100%; height: auto; aspect-ratio: 9 / 10; object-fit: cover; }
  @media (min-width: 900px) { video { aspect-ratio: 4 / 5; } }
  .alloatti-playback { position: absolute; right: 5px; bottom: 5px; display: grid; place-items: center; width: 44px; height: 44px; color: #fff; }
  .alloatti-playback span:not([hidden]) { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: #0009; }
  .alloatti-playback:focus-visible { outline: 2px solid #fff; outline-offset: -2px; border-radius: 50%; }
  a { position: absolute; inset-inline-start: 10px; bottom: 8px; max-width: calc(100% - 60px); display: grid; gap: 5px; justify-items: start; padding: 4px 2px; color: #fff; text-decoration: none; font-size: .75rem; font-weight: 600; }
  a img { width: 126px; max-width: 100%; height: auto; }
  a span { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  a:hover span { text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  @media (max-width: 899px) { .alloatti-card { width: min(100%, 250px); } }
</style>
