---
import Icon from './Icon.astro';
import InquiryCriteria from './InquiryCriteria.astro';
import EquipmentDetails from './EquipmentDetails.astro';
import ProductGallery from './ProductGallery.astro';
import { categories, conditions, formats, provinces, priceLabel } from '../lib/catalog.mjs';
import { getPhotos } from '../lib/db.mjs';
import { followupCurrency, listingStatuses, recordRevision } from '../lib/listing-management.mjs';
import { defaultInquirySource, inquirySources, inquiryStages, inquiryTimeframes, moneyInput, moneyLabel } from '../lib/inquiry-options.mjs';

const { record, kind, operation, closeUrl, actionUrl, error, submitted, link } = Astro.props;
const listing = kind === 'aviso';
const name = listing ? record.title : record.name;
const titles = { view: listing ? 'Detalle del aviso' : 'Detalle de la consulta', edit: listing ? 'Editar aviso' : 'Editar consulta',
  seller: 'Editar vendedor', delete: listing ? 'Eliminar aviso' : 'Eliminar consulta', restore: 'Restaurar registro',
  published: 'Publicar aviso', paused: 'Pausar aviso', sold: 'Marcar como vendido',
  followup: 'Seguimiento de la consulta', confirm: 'Confirmar disponibilidad' };
const notes = {
  delete: listing ? 'El aviso saldrá del catálogo y pasará a la papelera. Podés restaurarlo con sus fotos y contactos.'
    : 'La consulta pasará a la papelera. Podés recuperarla cuando lo necesites.',
  restore: listing ? 'El aviso volverá a su estado anterior. Si estaba publicado, volverá a aparecer en el catálogo.' : 'La consulta volverá a la bandeja.',
  published: 'El equipo aparecerá en el catálogo público. Los datos de contacto siguen en el panel.',
  paused: 'El equipo dejará de aparecer en el catálogo hasta que lo vuelvas a publicar.',
  sold: 'El equipo se marcará como vendido y dejará de aparecer en el catálogo.',
  confirm: 'Confirmá que el vendedor te indicó que la máquina sigue disponible.',
};
const value = (field: string) => submitted?.get(field) ?? record[field] ?? '';
const equipment = [ ['title','Título',90], ['brand','Marca',60], ['model','Modelo',60], ['format_detail','Medida',70], ['capacity','Capacidad',60] ];
const selects = [ ['category','Categoría',Object.entries(categories)], ['province','Provincia',provinces.map(province => [province, province])],
  ['condition','Estado del equipo',Object.entries(conditions)], ['format','Formato',Object.entries(formats)] ];
const edit = ['edit', 'seller', 'followup'].includes(operation);
const publishing = listing && operation === 'published';
const legacyContact = !listing && Boolean(record.contact && !record.buyer_email && !record.buyer_whatsapp);
const whatsapp = !listing && record.buyer_whatsapp?.startsWith('+') ? record.buyer_whatsapp.replace(/\D/g, '') : '';
const sources = [...new Set([defaultInquirySource, ...Object.values(inquirySources), listing ? defaultInquirySource : record.origin])];
const amountFields = [
  ['sale_amount', 'Importe de venta'], ['commission_agreed', 'Comisión acordada'], ['commission_paid', 'Comisión cobrada'],
];
const formatDate = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium', timeZone: 'America/Argentina/Buenos_Aires' });
const formatReceived = new Intl.DateTimeFormat('es-AR', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Argentina/Buenos_Aires' });
const currency = value('commission_currency') || followupCurrency(record);
---
<dialog open class:list={['admin-dialog', { 'admin-dialog-wide': edit || operation === 'view', 'admin-dialog-preview': publishing }]} aria-labelledby="panel-dialog-title" data-panel-dialog>
  <div class="admin-dialog-head">
    <span class:list={['admin-dialog-icon', { 'admin-danger-icon': operation === 'delete' }]}><Icon name={operation === 'delete' ? 'trash' : edit ? 'edit' : operation === 'restore' ? 'restore' : 'list'} size={22} /></span>
    <div><h2 id="panel-dialog-title">{titles[operation]}</h2><p>{name}{listing && <> · {record.ref}</>}</p></div>
    <a class="admin-icon-action admin-dialog-close" href={closeUrl} aria-label="Cerrar ventana" data-dialog-close><Icon name="close" size={20} /></a>
  </div>
  {operation === 'view' ? <>
    <div class="admin-dialog-body admin-detail">
      {listing ? <>
        <dl>
          <div><dt>Publicación</dt><dd>{listingStatuses[record.status]}</dd></div><div><dt>Precio</dt><dd>{priceLabel(record)}</dd></div>
          {record.status === 'published' && <div><dt>Última confirmación</dt><dd>{record.confirmed_at ? formatDate.format(record.confirmed_at * 1000) : 'Sin confirmar'}</dd></div>}
          {record.status === 'published' && record.reminded_at && <div><dt>Recordatorio enviado</dt><dd>{formatDate.format(record.reminded_at * 1000)}</dd></div>}
          <div><dt>Equipo</dt><dd>{[categories[record.category], record.brand, record.model].filter(Boolean).join(' · ')}</dd></div>
          <div><dt>Formato y estado</dt><dd>{[formats[record.format], record.format_detail, record.capacity, conditions[record.condition]].filter(Boolean).join(' · ')}</dd></div>
          <div><dt>Vendedor</dt><dd>{record.seller || 'Sin nombre'} · <a href={link('seller', kind, record.ref)}>Editar contacto</a></dd></div>
          <div><dt>{record.verified_at ? 'Email verificado' : 'Email sin verificar'}</dt><dd>{record.email || 'Sin email'}</dd></div>
          <div><dt>Contacto</dt><dd>{record.phone ? <><a href={`tel:${record.phone}`}>{record.phone}</a> · <a href={`https://wa.me/${record.phone.slice(1)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></> : record.contact || 'Sin teléfono'}</dd></div>
          <div><dt>Ubicación</dt><dd>{[record.address, record.locality, record.province].filter(Boolean).join(', ')}</dd></div>
        </dl>
        <p class="admin-prewrap">{record.description}</p>
        <div class="thumbs">{getPhotos(record).map((photo, index) => <a href={photo} target="_blank" rel="noopener noreferrer"><img src={photo} loading="lazy" alt={`Ver foto ${index + 1}`} /></a>)}</div>
        {record.video && <a href={record.video} target="_blank" rel="noopener noreferrer">Ver video</a>}
      </> : <>
        <dl>
          {legacyContact ? <div><dt>Contacto</dt><dd>{record.contact}</dd></div> : <>
            <div><dt>WhatsApp</dt><dd>{whatsapp ? <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer">{record.buyer_whatsapp}</a> : record.buyer_whatsapp || '—'}</dd></div>
            <div><dt>Correo electrónico</dt><dd>{record.buyer_email ? <a href={`mailto:${encodeURIComponent(record.buyer_email).replace('%40', '@')}`}>{record.buyer_email}</a> : '—'}</dd></div>
          </>}
          <div><dt>Origen</dt><dd>{record.origin}</dd></div>
          <div><dt>Estado</dt><dd>{inquiryStages[record.stage]}</dd></div>
          <div><dt>Localidad y provincia</dt><dd>{record.location || '—'}</dd></div>
          <div><dt>Presupuesto</dt><dd>{record.budget || '—'}</dd></div>
          <div><dt>Plazo</dt><dd>{inquiryTimeframes[record.timeframe] || '—'}</dd></div>
          {record.sale_amount != null && <div><dt>Importe de venta</dt><dd>{moneyLabel(record.sale_amount, record.commission_currency)}</dd></div>}
          {record.commission_agreed != null && <div><dt>Comisión acordada</dt><dd>{moneyLabel(record.commission_agreed, record.commission_currency)}</dd></div>}
          <div><dt>Comisión cobrada</dt><dd>{moneyLabel(record.commission_paid, record.commission_currency)}</dd></div>
          {record.closed_on && <div><dt>Fecha de cierre</dt><dd>{record.closed_on.split('-').reverse().join('/')}</dd></div>}
          {record.paid_on && <div><dt>Fecha de cobro</dt><dd>{record.paid_on.split('-').reverse().join('/')}</dd></div>}
        </dl>
        <p>{record.machine_title ?? (record.machine_ref || 'Pedido general')}</p>
        {record.message && <p class="admin-prewrap">{record.message}</p>}
        {record.notes && <p class="admin-prewrap"><strong>Notas internas</strong><br />{record.notes}</p>}
        {record.sample === 0 && !record.listing_deleted_at && <a href={link('view', 'aviso', record.machine_ref)}>Ver contacto del vendedor</a>}
      </>}
    </div>
    <div class="admin-dialog-foot">
      {listing && record.status !== 'published' && record.verified_at && <a class="button button-primary" href={link('published', kind, record.ref)}>Publicar aviso</a>}
      {listing && record.status === 'published' && <a class="button button-primary" href={link('confirm', kind, record.ref)}>Confirmar disponibilidad</a>}
      {listing && record.status === 'published' && <a class="button button-outline" href={link('paused', kind, record.ref)}>Pausar aviso</a>}
      {listing && record.status !== 'sold' && <a class="button button-outline" href={link('sold', kind, record.ref)}>Marcar como vendido</a>}
      {!listing && <a class="button button-primary" href={link('followup', kind, record.id)}>Actualizar seguimiento</a>}
      {!listing && <a class="button button-outline" href={link('edit', kind, record.id)}>Editar consulta</a>}
      <a class="button button-outline" href={closeUrl} autofocus>Cerrar</a>
    </div>
  </> : <form method="post" action={actionUrl} data-astro-reload class="form-stack admin-dialog-form">
    <input type="hidden" name="action" value="apply" />
    <input type="hidden" name="revision" value={recordRevision(record)} />
    <div class="admin-dialog-body">
      {error && <p class="message message-error" role="alert">{error}</p>}
      {operation === 'edit' && listing && <div class="admin-fields">
        {equipment.map(([field, label, limit]) => <label>{label}<input name={field} value={value(field)} maxlength={limit} required={field === 'title'} /></label>)}
        {selects.map(([field, label, options]) => <label>{label}<select name={field} required>{options.map(([key, title]) => <option value={key} selected={value(field) === key}>{title}</option>)}</select></label>)}
        <label>Precio fijo o desde ({record.currency})<input name="price" type="number" min="1" max="99999999999" step="1" value={value('price')} /></label>
        <label>Hasta ({record.currency}) <small>Solo para un rango</small><input name="price_max" type="number" min="1" max="99999999999" step="1" value={value('price_max')} /></label>
        <label class="admin-field-wide">Video de YouTube o Vimeo<input name="video" type="url" maxlength="300" value={value('video')} /></label>
        <label class="admin-field-wide">Descripción<textarea name="description" required maxlength="1600">{value('description')}</textarea></label>
      </div>}
      {operation === 'seller' && <div class="admin-fields">
        <label>Nombre y apellido<input name="seller" required maxlength="80" value={value('seller')} /></label>
        <label>{record.verified_at ? 'Email verificado' : 'Email sin verificar'}<input name="email" type="email" maxlength="254" value={record.verified_at ? record.email : value('email')} readonly={Boolean(record.verified_at)} /></label>
        <label>WhatsApp o teléfono<input name="phone" type="tel" maxlength="30" placeholder="+54 9 …" value={value('phone')} /></label>
        <label>Localidad<input name="locality" maxlength="80" value={value('locality')} /></label>
        <label class="admin-field-wide">Dirección<input name="address" maxlength="160" value={value('address')} /></label>
        {record.contact && <label class="admin-field-wide">Contacto anterior<input name="contact" maxlength="100" value={value('contact')} /></label>}
      </div>}
      {operation === 'edit' && !listing && <div class="admin-fields">
        <label>Nombre<input name="name" maxlength="80" required value={value('name')} /></label>
        {legacyContact ? <label>Contacto<input name="contact" maxlength="100" required value={value('contact')} /></label> : <>
          <label>WhatsApp<input name="buyer_whatsapp" type="tel" maxlength="30" required value={value('buyer_whatsapp')} /></label>
          <label>Correo electrónico<input name="buyer_email" type="email" maxlength="254" required value={value('buyer_email')} /></label>
        </>}
        <label class="admin-field-wide">Mensaje<textarea name="message" maxlength="1200" required={!record.machine_ref || Boolean(record.manual)}>{value('message')}</textarea></label>
      </div>}
      {operation === 'followup' && <div class="form-stack">
        <div class="followup-context">
          <strong>{record.machine_title || record.machine_ref || 'Pedido general'}</strong>
          <p>{[formatReceived.format(new Date(record.created_at.replace(' ', 'T') + 'Z')), record.origin].filter(Boolean).join(' · ')}</p>
          <p>{[record.buyer_whatsapp, record.buyer_email, legacyContact && record.contact].filter(Boolean).join(' · ')}</p>
          {record.message && <p class="followup-message">{record.message}</p>}
        </div>
        <div class="admin-fields">
          <label>Estado<select name="stage" required>{Object.entries(inquiryStages).map(([id, label]) =>
            <option value={id} selected={value('stage') === id}>{label}</option>)}</select></label>
          <label class="admin-field-wide">Notas internas<textarea name="notes" rows="2" maxlength="2000" placeholder="Ej. próxima llamada o condiciones acordadas.">{value('notes')}</textarea></label>
        </div>
        <details class="followup-extra"><summary>Datos opcionales</summary><div class="admin-fields">
          <label>Origen<select name="origin" required>{sources.map(source =>
            <option value={source} selected={value('origin') === source}>{source}</option>)}</select></label>
          <InquiryCriteria value={value} />
        </div></details>
        <details class="followup-extra" open={Boolean(error)}><summary>Cierre y comisión</summary><div class="admin-fields">
          <label>Fecha de cierre <small>Se completa al marcar Cerrada</small><input name="closed_on" type="date" value={value('closed_on')} /></label>
          <label>Moneda<select name="commission_currency"><option value="">Sin definir</option>{['USD', 'ARS'].map(option =>
            <option value={option} selected={currency === option}>{option}</option>)}</select></label>
          {amountFields.map(([field, label]) => <label>{label}<input name={field} inputmode={field === 'commission_agreed' ? 'text' : 'decimal'} maxlength="14"
            placeholder={field === 'commission_agreed' ? 'Ej. 5% o 100' : undefined}
            value={submitted?.get(field) ?? moneyInput(record[field])} /></label>)}
          <label>Fecha de cobro<input name="paid_on" type="date" value={value('paid_on')} /></label>
        </div></details>
      </div>}
      {publishing && <div class="detail-grid admin-publish-preview">
        <ProductGallery photos={getPhotos(record)} title={record.title} preview />
        <EquipmentDetails machine={record} heading="h3" />
      </div>}
      {!edit && <p class:list={[publishing && 'admin-publish-note']}>{notes[operation]}</p>}
    </div>
    <div class="admin-dialog-foot">
      <a class="button button-outline" href={closeUrl} autofocus>Cancelar</a>
      {publishing && <a class="button button-outline" href={link('edit', kind, record.ref)}>Editar aviso</a>}
      <button class:list={['button', operation === 'delete' ? 'admin-danger-button' : 'button-primary']} type="submit">{edit ? 'Guardar cambios' : operation === 'delete' ? 'Mover a la papelera' : titles[operation]}</button>
    </div>
  </form>}
</dialog>

<style>
  .followup-context { display: grid; gap: 4px; font-size: .875rem; color: var(--muted); }
  .followup-context strong { color: var(--ink); }
  .followup-message { white-space: pre-line; }
  .followup-extra { border-top: 1px solid var(--line); padding-top: 8px; }
  .followup-extra summary { color: var(--deep); font-size: .875rem; font-weight: 650; cursor: pointer; }
  .followup-extra .admin-fields { margin-top: 10px; }
  textarea[name="notes"] {
    field-sizing: content;
    min-height: 72px;
    max-height: 40dvh;
    resize: none;
    overflow-y: auto;
  }
</style>

