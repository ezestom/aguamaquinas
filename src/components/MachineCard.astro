---
import Icon from './Icon.astro';
import { conditions, priceLabel } from '../lib/catalog.mjs';
import { getPhotos } from '../lib/db.mjs';
const { machine, params, priority, promotion, compact = false } = Astro.props;
const badge = promotion ?? (machine.reference ? 'Referencia' : undefined);
const photo = getPhotos(machine)[0];
const location = machine.locality?.trim() || machine.province;
const query = params.toString();
const href = `/equipos/${machine.ref}${query ? `?${query}` : ''}`;
---
<article class:list={['machine-card', compact && 'machine-card-compact']}>
  <div class="card-media">
    <div class="card-image">
      <img data-card-photo src={photo} alt="" width="540" height="360" loading={priority ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <span class="card-arrow" aria-hidden="true">
      <span class="card-arrow-disc"><Icon name="up-right" size={18} /></span>
    </span>
  </div>
  <div class="card-body">
    <h3><a href={href}>{machine.title}</a></h3>
    <p class="card-status"><span>{conditions[machine.condition]}</span>{badge && <span class:list={['card-promotion', promotion && 'is-promoted']}>{badge}</span>}</p>
    <p class="card-location"><Icon name="pin" size={15} />{location}</p>
    <div class="card-bottom"><strong class:list={[machine.reference && 'price-unlisted']}>{machine.reference ? 'Sin precio publicado' : priceLabel(machine)}</strong></div>
  </div>
</article>

<style>
  .machine-card { position: relative; }
  .card-media {
    --arrow-size: 44px;
    --notch-size: calc(var(--arrow-size) + 8px);
    --fillet: 12px;
    position: relative;
  }
  .card-image { border-radius: var(--radius-surface); }
  .card-media::before, .card-media::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: var(--fillet);
    height: var(--fillet);
    background: radial-gradient(circle at top left, transparent calc(var(--fillet) - 0.5px), var(--surface) var(--fillet));
  }
  .card-media::before { right: 0; bottom: var(--notch-size); }
  .card-media::after { right: var(--notch-size); bottom: 0; }
  .card-arrow {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: end;
    width: var(--notch-size);
    height: var(--notch-size);
    border-top-left-radius: calc(var(--notch-size) - var(--arrow-size) / 2);
    background: var(--surface);
  }
  .card-arrow-disc {
    display: grid;
    place-items: center;
    width: var(--arrow-size);
    height: var(--arrow-size);
    border-radius: 50%;
    background: var(--blue-disc-fill);
    box-shadow: var(--blue-disc-shadow);
    color: var(--blue-disc-ink);
  }
  .machine-card:has(a:focus-visible) { outline: 2px solid var(--primary); outline-offset: 2px; }
  .machine-card:is(:hover, :focus-within) .card-arrow-disc { filter: brightness(1.05); }
  .card-body { gap: 5px; }
  .card-body h3 { margin: 0; overflow-wrap: anywhere; }
  .card-body h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .card-status { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: .8125rem; color: var(--muted); }
  .card-promotion.is-promoted { color: var(--deep); font-weight: 600; }
  .card-location { margin-bottom: 0; overflow-wrap: anywhere; }
  .card-location svg { flex: none; }
  .card-bottom { margin-top: auto; padding-top: 6px; }
  .card-bottom .price-unlisted { font-size: .8125rem; font-weight: 450; color: var(--muted); }
  .machine-card-compact { scroll-snap-align: start; }
  .machine-card-compact .card-media { --arrow-size: 36px; }
  .machine-card-compact .card-body { padding: 12px; }
  .machine-card-compact h3 { font-size: .9375rem; }
  .machine-card-compact :is(.card-location, .card-bottom strong) { font-size: .8125rem; }
</style>
