---
import Icon from "./Icon.astro";
const { origin } = Astro.props;
const tracking = "?utm_source=aguamaquinas&utm_medium=referido";
const links = [
	{
		title: "Marketplace",
		items: [
			["Inicio", "/" + origin],
			["Ver lavadoras", "/?categoria=lavadoras"],
			["Ver llenadoras", "/?categoria=llenadoras"],
			["Publicá gratis", "/publicar"],
		],
	},
	{
		title: "Ayuda",
		items: [
			["Pedir un equipo o consultar", "/consulta" + origin],
			["Panel de gestión", "/panel"],
		],
	},
	{
		title: "Equipos nuevos · Alloatti",
		items: [
			[
				"Líneas de bidones retornables",
				`https://www.alloatti.com/maquina-para-bidones-retornables${tracking}`,
			],
			[
				"Líneas para descartables y PET",
				`https://www.alloatti.com/maquina-para-bidones-descartables${tracking}`,
			],
			[
				"Accesorios y automatización",
				`https://www.alloatti.com/accesorios-para-maquinas${tracking}`,
			],
		],
	},
];
---

<footer class="site-footer">
	<div class="wrap">
		<div
			class="footer-grid grid grid-cols-2 gap-x-5 gap-y-5 py-7 lg:grid-cols-[1.2fr_0.8fr_0.8fr_1fr] lg:gap-x-8 lg:py-8">
			<div class="footer-brand col-span-2 sm:col-span-1">
				<a class="brand" href={"/" + origin}>
					<img
						class="brand-icon"
						src="/agua-logo.webp"
						alt=""
						width="34"
						height="34"
						loading="lazy"
					/>
					<span><strong>Agua Máquinas</strong><small>Maquinaria para agua y soda</small></span>
				</a>
			</div>
			{
				links.map((group, index) => (
					<nav class:list={[index === links.length - 1 && 'col-span-2 sm:col-span-1']} aria-label={group.title}>
						<h2>{group.title}</h2>
						<ul class="grid gap-1">
							{group.items.map(([label, href]) => (
								<li>
									<a href={href}>
										{label}
										{href.startsWith("https:") && (
											<Icon name="external" size={13} />
										)}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
		<div
			class="footer-base flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-3">
			<p>© {new Date().getFullYear()} Agua Máquinas</p>
			<a
				class="developer-credit inline-flex items-center gap-2.5"
				href="https://ezestom.is-a.dev/"
				target="_blank"
				rel="noopener noreferrer">
				<span>Desarrollado por </span>
				<img
					src="/ezestom.webp"
					alt=""
					width="16"
					height="16"
					loading="lazy"
				/>
			</a>
		</div>
	</div>
</footer>
