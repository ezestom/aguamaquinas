---
const { origin } = Astro.props;
const whatsapp = (import.meta.env.DEV
	? import.meta.env.AGUA_WHATSAPP_NUMBER
	: process.env.AGUA_WHATSAPP_NUMBER)?.trim() ?? "";
const whatsappDigits = whatsapp.replace(/^\+/, "");
const whatsappUpdates = (import.meta.env.DEV
	? import.meta.env.AGUA_WHATSAPP_GROUP_URL
	: process.env.AGUA_WHATSAPP_GROUP_URL)?.trim() ?? "";
const isWhatsAppGroup = /^https:\/\/chat\.whatsapp\.com\/[a-z0-9]+\/?(?:\?[^\s#]*)?$/i.test(whatsappUpdates);
const isWhatsAppChannel = /^https:\/\/(?:www\.)?whatsapp\.com\/channel\/[a-z0-9]+\/?(?:\?[^\s#]*)?$/i.test(whatsappUpdates);
const category = (name: string) => '/?' + new URLSearchParams({ ...Object.fromEntries(new URLSearchParams(origin)), categoria: name });
const links = [
	{
		title: "Equipos",
		items: [
			["Inicio", "/" + origin],
			["Ver lavadoras", category("lavadoras")],
			["Ver llenadoras", category("llenadoras")],
			["Publicá gratis", "/publicar"],
		],
	},
	{
		title: "Ayuda",
		items: [
			["Pedir un equipo o consultar", "/consulta" + origin],
			["Enviar un comentario", "/sugerencias" + origin],
			["Panel de gestión", "/panel"],
		],
	},
];
const whatsappLinks = [
	...(/^\d{8,15}$/.test(whatsappDigits) ? [["Escribinos al " + whatsapp, "https://wa.me/" + whatsappDigits]] : []),
	...(isWhatsAppGroup || isWhatsAppChannel
		? [[isWhatsAppChannel ? "Seguí el canal de nuevos ingresos" : "Sumate al grupo de nuevos ingresos", whatsappUpdates]] : []),
];
if (whatsappLinks.length) links.push({ title: "WhatsApp", items: whatsappLinks });
---

<footer class="site-footer">
	<div class="wrap">
		<div
			class:list={[
				"footer-grid grid grid-cols-2 gap-x-5 gap-y-5 py-7 lg:gap-x-8 lg:py-8",
				whatsappLinks.length ? "lg:grid-cols-[1.35fr_1fr_1.2fr_1.4fr]" : "lg:grid-cols-[2fr_1fr_1fr]",
			]}>
			<div class="footer-brand col-span-2 sm:col-span-1">
				<a class="brand" href={"/" + origin}>
					<img
						class="brand-icon"
						src="/agua-logo.webp"
						alt=""
						width="34"
						height="34"
						loading="lazy"
					/>
					<span><strong>Agua Máquinas</strong><small>Maquinaria para agua y soda</small></span>
				</a>
			</div>
			{
				links.map((group) => (
					<nav aria-label={group.title}>
						<h2>{group.title}</h2>
						<ul class="grid gap-1">
							{group.items.map(([label, href]) => (
								<li>
									<a href={href}>
										{label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
		<div
			class="footer-base flex flex-wrap items-center justify-between gap-x-8 gap-y-2 py-3">
			<p>© {new Date().getFullYear()} Agua Máquinas</p>
			<a
				class="developer-credit inline-flex items-center gap-2.5"
				href="https://ezestom.is-a.dev/"
				target="_blank"
				rel="noopener noreferrer">
				<span>Desarrollado por </span>
				<img
					src="/ezestom.webp"
					alt=""
					width="16"
					height="16"
					loading="lazy"
				/>
			</a>
		</div>
	</div>
</footer>
