---
import Icon from './Icon.astro';

interface Slide {
  title: string;
  description?: string;
  label?: string;
  href?: string;
  id?: number;
  has_image?: number;
  sponsored?: number;
  photo?: string;
  fit?: 'contain';
  backdrop?: string;
}

interface Props {
  campaigns: Slide[];
  inquiryHref: string;
}

const { campaigns, inquiryHref } = Astro.props;
const previews = import.meta.env.DEV && !campaigns.length
  ? (await import('../lib/campaign-previews.mjs')).default
  : [];
const slides: Slide[] = campaigns.length ? campaigns : previews.length ? previews : [
  { title: '¿Qué equipo necesitás?', description: 'Contanos qué buscás para tu línea de envasado.', label: 'Pedir un equipo', href: inquiryHref, backdrop: '/equipos/linea.webp' },
  { title: 'Vendé tu maquinaria', description: 'Publicá tu equipo para que lo encuentren compradores del sector.', label: 'Publicar gratis', href: '/publicar', backdrop: '/equipos/lavadora.webp' },
];
---
<home-carousel class="home-carousel" role="region" aria-label="Campañas de Agua Máquinas">
  {previews.length > 0 && <span class="campaign-preview-label">Vista de prueba</span>}
  {slides.length > 1 && <div class="home-campaign-controls" data-controls hidden>
    <div class="home-campaign-picker">
      <button class="campaign-rotation" type="button" data-rotation aria-label="Pausar rotación">
        <span data-pause><Icon name="pause" size={16} /></span>
        <span data-play hidden><Icon name="play" size={16} /></span>
      </button>
      <div class="home-campaign-dots" role="group" aria-label="Elegir campaña">
        {slides.map((slide, index) => <button type="button" data-dot={index} aria-label={`Campaña ${index + 1} de ${slides.length}, ${slide.title}`} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}
      </div>
    </div>
    <button class="campaign-arrow" type="button" data-step="-1" aria-label="Campaña anterior"><Icon name="previous" size={24} /></button>
    <button class="campaign-arrow" type="button" data-step="1" aria-label="Campaña siguiente"><Icon name="next" size={24} /></button>
    <span class="visually-hidden" data-status role="status"></span>
  </div>}
  <div class="home-campaign-track" data-track>
    {slides.map((slide, index) => {
      const photo = slide.photo ?? (slide.has_image ? `/campanas/${slide.id}.webp` : '');
      const sponsored = Boolean(slide.sponsored);
      return <article class:list={['home-campaign', (photo || slide.backdrop) && 'home-campaign-image', slide.backdrop && 'home-campaign-backdrop']} data-slide aria-label={slide.title}>
        {slide.backdrop && <img class="home-campaign-photo" src={slide.backdrop} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
        {sponsored && <span class="campaign-sponsored">Publicidad</span>}
        {slide.photo ? <img class:list={['home-campaign-photo', 'preview-photo', slide.fit === 'contain' && 'preview-photo-contained']} src={photo} alt={`Banner de ejemplo de ${slide.title}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          : photo ? <a class="home-campaign-image-link" href={slide.href} rel={sponsored ? 'sponsored' : undefined}>
            <img class="home-campaign-photo" src={photo} alt={slide.title} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <span class="visually-hidden">{slide.description}. {slide.label}</span>
          </a>
          : <div class="wrap home-campaign-copy">
            <h2>{slide.title}</h2>
            <p>{slide.description}</p>
            <a class="button button-outline home-campaign-cta" href={slide.href} rel={sponsored ? 'sponsored' : undefined}>{slide.label} <Icon name="arrow" size={17} /></a>
          </div>}
      </article>;
    })}
  </div>
</home-carousel>

<script>
  import { scrollToSnap, snapIndex } from './snap-carousel';

  class HomeCarousel extends HTMLElement {
    listeners?: AbortController;
    timer?: number;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-track]');
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      const rotation = controls?.querySelector<HTMLButtonElement>('[data-rotation]');
      if (!track || !controls || !rotation) return;
      const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...controls.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      const status = controls.querySelector('[data-status]');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      let active = -1;
      let rotating = !motion.matches;
      let hovering = false;

      const schedule = () => {
        window.clearTimeout(this.timer);
        if (rotating && !hovering && !document.hidden && !this.matches(':focus-within')) {
          this.timer = window.setTimeout(() => goTo(active + 1), 5000);
        }
      };
      const sync = () => {
        const index = snapIndex(track, slides.length);
        if (active === index) return;
        active = index;
        slides.forEach((slide, index) => {
          slide.inert = index !== active;
          if (index === active) dots[index].setAttribute('aria-current', 'true');
          else dots[index].removeAttribute('aria-current');
        });
      };
      const goTo = (index: number, announce = false) => {
        const next = (index + slides.length) % slides.length;
        scrollToSnap(track, next, Math.abs(next - active) > 1);
        if (announce && status) status.textContent = dots[next].getAttribute('aria-label');
        schedule();
      };
      const updateRotation = () => {
        rotation.setAttribute('aria-label', rotating ? 'Pausar rotación' : 'Reproducir rotación');
        rotation.querySelector<HTMLElement>('[data-pause]')!.hidden = !rotating;
        rotation.querySelector<HTMLElement>('[data-play]')!.hidden = rotating;
        schedule();
      };

      track.addEventListener('scroll', () => { sync(); schedule(); }, { passive: true, signal });
      controls.querySelector('[data-step="-1"]')?.addEventListener('click', () => goTo(active - 1, true), { signal });
      controls.querySelector('[data-step="1"]')?.addEventListener('click', () => goTo(active + 1, true), { signal });
      dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index, true), { signal }));
      this.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const index = active + (event.key === 'ArrowLeft' ? -1 : 1);
        if (track.contains(document.activeElement)) rotation.focus({ preventScroll: true });
        goTo(index, true);
      }, { signal });
      rotation.addEventListener('click', () => { rotating = !rotating; updateRotation(); }, { signal });
      motion.addEventListener('change', () => { rotating = !motion.matches; updateRotation(); }, { signal });
      this.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovering = true; schedule(); } }, { signal });
      this.addEventListener('pointerleave', () => { hovering = false; schedule(); }, { signal });
      this.addEventListener('focusin', schedule, { signal });
      this.addEventListener('focusout', () => queueMicrotask(() => { if (!signal.aborted) schedule(); }), { signal });
      document.addEventListener('visibilitychange', schedule, { signal });
      sync();
      controls.hidden = false;
      updateRotation();
    }

    disconnectedCallback() {
      this.listeners?.abort();
      window.clearTimeout(this.timer);
    }
  }

  if (!customElements.get('home-carousel')) customElements.define('home-carousel', HomeCarousel);
</script>

<style>
  .home-carousel { display: block; position: relative; min-width: 0; background: var(--subtle); }
  .home-campaign-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .home-campaign { position: relative; display: grid; align-items: center; min-width: 0; flex: 0 0 100%; scroll-snap-align: start; }
  .home-campaign-image { min-height: clamp(160px, 26vw, 420px); }
  .home-campaign-image:has(.preview-photo) { min-height: clamp(210px, 25vw, 420px); }
  .home-campaign-copy { padding-block: 20px 58px; padding-inline: 44px; }
  .home-campaign h2 { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.2; font-weight: 650; overflow-wrap: anywhere; }
  .home-campaign p { margin: 5px 0 10px; color: var(--muted); overflow-wrap: anywhere; }
  .home-campaign-cta { min-height: 44px; max-width: 100%; overflow-wrap: anywhere; }
  .home-campaign-cta svg { flex-shrink: 0; }
  .home-campaign-image-link, .home-campaign-photo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-campaign-image-link:focus-visible { outline-offset: -4px; }
  .home-campaign-photo { object-fit: cover; }
  .home-campaign-backdrop .home-campaign-photo { object-fit: cover; object-position: center; }
  .home-campaign-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #101e31f5, #101e31a6 60%, #101e3140); pointer-events: none; }
  .home-campaign-backdrop .home-campaign-copy { position: relative; z-index: 1; color: #fff; }
  .home-campaign-backdrop p { color: #e0e9f5; }
  .home-campaign-backdrop .home-campaign-cta { background: #fff; color: #14243a; }
  .home-campaign-backdrop .home-campaign-cta:hover { background: #e0e9f5; }
  .preview-photo { object-fit: cover; object-position: center top; }
  .home-campaign:has(.preview-photo-contained) { min-height: 0; }
  .preview-photo-contained { position: static; display: block; height: auto; aspect-ratio: 1536 / 399; object-fit: contain; }
  .campaign-preview-label, .campaign-sponsored {
    position: absolute;
    z-index: 1;
    top: 8px;
    inset-inline-end: clamp(10px, 2vw, 30px);
    padding: 3px 8px;
    border-radius: 4px;
    background: #14243a;
    color: #fff;
    font-size: .75rem;
    pointer-events: none;
  }
  .home-campaign:has(.campaign-sponsored) .home-campaign-copy { padding-top: 32px; }
  .home-campaign-controls { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .home-campaign-controls button { display: grid; place-items: center; min-width: 44px; height: 44px; pointer-events: auto; }
  .home-campaign-controls button:focus-visible { outline: 2px solid #174c91; outline-offset: -4px; }
  .campaign-arrow, .home-campaign-picker { position: absolute; background: #fffffff2; color: #174c91; border-radius: 999px; box-shadow: 0 2px 10px #14243a26; }
  .home-campaign-controls .campaign-arrow { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; }
  .campaign-arrow[data-step="-1"] { inset-inline-start: 14px; }
  .campaign-arrow[data-step="1"] { inset-inline-end: 14px; }
  .home-campaign-picker { display: flex; align-items: center; bottom: 10px; left: 50%; transform: translateX(-50%); padding-inline-end: 6px; }
  .home-campaign-picker button { border-radius: 999px; }
  .home-campaign-controls button:hover { background: #e7effa; }
  .campaign-rotation span { display: grid; place-items: center; }
  .home-campaign-dots { display: flex; }
  .home-campaign-dots button { min-width: 22px; }
  .home-campaign-dots span { width: 7px; height: 7px; border: 1px solid currentColor; border-radius: 50%; }
  .home-campaign-dots button[aria-current] span { background: currentColor; }
  @media (max-width: 600px) {
    .home-campaign:has(.preview-photo-contained) { padding-bottom: 54px; background: #fff; }
    .home-campaign-image { min-height: 160px; }
    .home-campaign-image-link .home-campaign-photo { object-fit: contain; }
    .home-campaign-copy { padding-inline: 0; }
    .home-campaign-controls .campaign-arrow { top: auto; bottom: 10px; transform: none; width: 44px; height: 44px; }
    .campaign-arrow[data-step="-1"] { inset-inline-start: 6px; }
    .campaign-arrow[data-step="1"] { inset-inline-end: 6px; }
    .home-campaign-dots button { min-width: 20px; }
  }
</style>
