---
import Icon from './Icon.astro';

interface Slide {
  title: string;
  description?: string;
  label?: string;
  href?: string;
  id?: number;
  has_image?: number;
  sponsored?: number;
  photo?: string;
  fit?: 'contain';
  backdrop?: string;
  productPhoto?: string;
}

interface Props {
  campaigns: Slide[];
  inquiryHref: string;
}

const { campaigns, inquiryHref } = Astro.props;
const previews = import.meta.env.DEV && !campaigns.length
  ? (await import('../lib/campaign-previews.mjs')).default
  : [];
const slides: Slide[] = campaigns.length ? campaigns : previews.length ? previews : [
  { title: '¿Qué equipo necesitás?', description: 'Contanos qué buscás para tu línea de envasado.', label: 'Pedir un equipo', href: inquiryHref, productPhoto: '/equipos/linea.webp' },
  { title: 'Vendé tu maquinaria', description: 'Publicá tu equipo para que lo encuentren compradores del sector.', label: 'Publicar gratis', href: '/publicar', productPhoto: '/equipos/lavadora.webp' },
];
---
<home-carousel class="home-carousel" role="region" aria-label="Campañas de Agua Máquinas">
  {slides.length > 1 && <div class="home-campaign-controls" data-controls hidden>
    <button class="campaign-arrow" type="button" data-step="-1" aria-label="Campaña anterior"><Icon name="previous" size={24} /></button>
    <button class="campaign-arrow" type="button" data-step="1" aria-label="Campaña siguiente"><Icon name="next" size={24} /></button>
    <span class="visually-hidden" data-status role="status"></span>
  </div>}
  <div class="home-campaign-track" data-track>
    {slides.map((slide, index) => {
      const photo = slide.photo ?? (slide.has_image ? `/campanas/${slide.id}.webp` : '');
      const sponsored = Boolean(slide.sponsored);
      const actionLabel = sponsored ? `Ver ${slide.title}` : slide.label;
      const productPhoto = slide.productPhoto ?? (sponsored ? photo : '');
      return <article class:list={['home-campaign', (photo || slide.backdrop) && 'home-campaign-image', slide.backdrop && 'home-campaign-backdrop', productPhoto && 'home-campaign-product']} data-slide aria-label={slide.title}>
        {slide.backdrop && <img class="home-campaign-photo" src={slide.backdrop} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
        {sponsored && <span class="campaign-sponsored">Publicidad</span>}
        {productPhoto ? <div class="wrap campaign-layout">
          <div class="campaign-product-copy">
            <h2>{slide.title}</h2>
            <p>{slide.description}</p>
            <a class="button home-campaign-cta" href={slide.href} rel={sponsored ? 'sponsored' : undefined}>{actionLabel} <Icon name="arrow" size={18} /></a>
          </div>
          <img class:list={['campaign-product-photo', sponsored && 'campaign-sponsored-photo']} src={productPhoto} alt="" width="720" height="400" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div> : slide.photo ? <img class:list={['home-campaign-photo', 'preview-photo', slide.fit === 'contain' && 'preview-photo-contained']} src={photo} alt={`Banner de ejemplo de ${slide.title}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          : photo ? <a class="home-campaign-image-link" href={slide.href} rel={sponsored ? 'sponsored' : undefined}>
            <img class="home-campaign-photo" src={photo} alt={slide.title} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <span class="visually-hidden">{slide.description}. {slide.label}</span>
          </a>
          : <div class="wrap home-campaign-copy">
            <h2>{slide.title}</h2>
            <p>{slide.description}</p>
            <a class="button button-outline home-campaign-cta" href={slide.href} rel={sponsored ? 'sponsored' : undefined}>{actionLabel} <Icon name="arrow" size={17} /></a>
          </div>}
      </article>;
    })}
  </div>
</home-carousel>

<script>
  import { scrollToSnap, snapIndex } from './snap-carousel';

  class HomeCarousel extends HTMLElement {
    listeners?: AbortController;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('[data-track]');
      const controls = this.querySelector<HTMLElement>('[data-controls]');
      const previous = controls?.querySelector<HTMLButtonElement>('[data-step="-1"]');
      const next = controls?.querySelector<HTMLButtonElement>('[data-step="1"]');
      if (!track || !controls || !previous || !next) return;
      const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
      const status = controls.querySelector('[data-status]');
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      let active = -1;
      const sync = () => {
        const index = snapIndex(track, slides.length);
        if (active === index) return;
        active = index;
        slides.forEach((slide, index) => {
          slide.inert = index !== active;
        });
      };
      const goTo = (index: number) => {
        const target = (index + slides.length) % slides.length;
        scrollToSnap(track, target, Math.abs(target - active) > 1);
        if (status) status.textContent = slides[target].getAttribute('aria-label');
      };

      track.addEventListener('scroll', sync, { passive: true, signal });
      previous.addEventListener('click', () => goTo(active - 1), { signal });
      next.addEventListener('click', () => goTo(active + 1), { signal });
      this.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const backwards = event.key === 'ArrowLeft';
        if (track.contains(document.activeElement)) {
          (backwards ? previous : next).focus({ preventScroll: true });
        }
        goTo(active + (backwards ? -1 : 1));
      }, { signal });
      sync();
      controls.hidden = false;
    }

    disconnectedCallback() {
      this.listeners?.abort();
    }
  }

  if (!customElements.get('home-carousel')) customElements.define('home-carousel', HomeCarousel);
</script>

<style>
  .home-carousel {
    --campaign-fade-size: 116px;
    display: block;
    position: relative;
    min-width: 0;
    background:
      linear-gradient(to bottom, transparent 40%, var(--campaign-fade-edge, var(--surface))),
      radial-gradient(ellipse at 28% 4%, #f4fbff 0%, transparent 68%),
      radial-gradient(ellipse at 82% 35%, #c5e2ff 0%, #a4ccff 55%, #dceeff 100%);
  }
  .home-campaign { color: var(--deep); }
  .campaign-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); align-items: center; gap: 48px; padding: 44px 44px 72px; }
  .home-campaign.home-campaign-product h2 { max-width: 13ch; font-size: clamp(30px, 3.5vw, 50px); line-height: 1.12; letter-spacing: -.03em; font-weight: 650; text-wrap: balance; }
  .home-campaign.home-campaign-product p { max-width: 38ch; margin: 18px 0 24px; font-size: 18px; line-height: 1.6; }
  .home-campaign-product .home-campaign-cta { background: var(--surface); color: var(--deep); }
  .home-campaign-product .home-campaign-cta:hover { background: var(--tint); }
  .campaign-product-photo { width: 100%; height: 280px; object-fit: cover; border-radius: 14px; }
  .campaign-product-photo:not(.campaign-sponsored-photo) { box-shadow: 0 14px 28px -12px rgb(20 36 58 / 32%); }
  .campaign-sponsored-photo { object-fit: contain; }
  .home-campaign-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; }
  .home-campaign { position: relative; display: grid; align-items: center; min-width: 0; flex: 0 0 100%; scroll-snap-align: start; }
  .home-campaign-image { min-height: clamp(160px, 26vw, 420px); }
  .home-campaign-image:has(.preview-photo) { min-height: clamp(210px, 25vw, 420px); }
  .home-campaign-copy { padding-block: 20px 58px; padding-inline: 44px; }
  .home-campaign h2 { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.2; font-weight: 650; overflow-wrap: anywhere; }
  .home-campaign p { margin: 5px 0 10px; color: inherit; overflow-wrap: anywhere; }
  .home-campaign-cta { min-height: 44px; max-width: 100%; overflow-wrap: anywhere; }
  .home-campaign-cta svg { flex-shrink: 0; }
  .home-campaign-image-link, .home-campaign-photo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .home-campaign-image-link:focus-visible { outline-offset: -4px; }
  .home-campaign-photo { object-fit: cover; }
  .home-campaign-image-link .home-campaign-photo {
    mask-image: linear-gradient(to bottom, #000 calc(100% - var(--campaign-fade-size)), transparent);
  }
  .home-campaign-backdrop .home-campaign-photo { object-fit: cover; object-position: center; }
  .home-campaign-backdrop::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #101e31f5, #101e31a6 60%, #101e3140); pointer-events: none; }
  .home-campaign-backdrop .home-campaign-copy { position: relative; z-index: 1; color: #fff; }
  .home-campaign-backdrop p { color: #e0e9f5; }
  .home-campaign-backdrop .home-campaign-cta { background: #fff; color: #14243a; }
  .home-campaign-backdrop .home-campaign-cta:hover { background: #e0e9f5; }
  .preview-photo { object-fit: cover; object-position: center top; }
  .home-campaign:has(.preview-photo-contained) { min-height: 0; }
  .preview-photo-contained { position: static; display: block; height: auto; aspect-ratio: 1536 / 399; object-fit: contain; }
  .campaign-sponsored {
    position: absolute;
    z-index: 1;
    top: 8px;
    inset-inline-end: clamp(10px, 2vw, 30px);
    padding: 3px 8px;
    border-radius: var(--radius);
    background: #14243a;
    color: #fff;
    font-size: .75rem;
    pointer-events: none;
  }
  .home-campaign:has(.campaign-sponsored) .home-campaign-copy { padding-top: 32px; }
  .home-campaign-controls { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .home-campaign-controls button { display: grid; place-items: center; min-width: 44px; height: 44px; pointer-events: auto; }
  .home-campaign-controls button:focus-visible { outline: 2px solid #14243a; outline-offset: -4px; }
  .campaign-arrow { position: absolute; background: #ffffff70; color: #14243a; border-radius: var(--radius); }
  .home-campaign-controls .campaign-arrow { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; }
  .campaign-arrow[data-step="-1"] { inset-inline-start: 14px; }
  .campaign-arrow[data-step="1"] { inset-inline-end: 14px; }
  .home-campaign-controls button:hover,
  .home-campaign-controls button:focus-visible { background: #ffffffb3; }
  @media (min-width: 900px) {
    .home-carousel { --campaign-fade-size: 94px; }
    .campaign-layout {
      gap: clamp(38px, 5vw, 72px);
    }
    .home-campaign.home-campaign-product h2 { font-size: clamp(2.25rem, 3.4vw, 3.25rem); }
    .home-campaign.home-campaign-product p { margin: 14px 0 19px; font-size: 0.9375rem; }
    .campaign-product-photo { height: clamp(260px, 36vh, 320px); }
    .home-campaign-image { min-height: clamp(160px, 26vw, 336px); }
    .home-campaign-image:has(.preview-photo) { min-height: clamp(210px, 25vw, 336px); }
    .home-campaign-cta { font-size: 0.8125rem; }
  }
  @media (min-width: 900px) and (pointer: fine) {
    .home-campaign-cta { min-height: 36px; padding: 7px 14px; }
    .home-campaign-controls .campaign-arrow { min-width: 40px; width: 40px; height: 40px; }
    .campaign-arrow[data-step="-1"] { inset-inline-start: 11px; }
    .campaign-arrow[data-step="1"] { inset-inline-end: 11px; }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .campaign-layout { padding-block: 30px 38px; }
    .home-campaign.home-campaign-product h2 { font-size: clamp(2.25rem, 3.4vw, 2.75rem); }
    .home-campaign.home-campaign-product p { margin-block: 12px 16px; }
  }
  @media (width < 900px) {
    .campaign-layout { gap: 24px; padding-inline: 36px; }
    .campaign-product-photo { height: 240px; }
  }
  @media (max-width: 600px) {
    .campaign-layout { grid-template-columns: 1fr; gap: 24px; padding: 32px 0 76px; }
    .home-campaign.home-campaign-product h2 { max-width: 18ch; }
    .home-campaign.home-campaign-product p { font-size: 16px; margin: 12px 0 20px; }
    .campaign-product-photo { height: clamp(185px, 53vw, 240px); }
    .campaign-product-copy .button { min-height: 46px; }
    .home-campaign:has(.preview-photo-contained) { padding-bottom: 54px; background: #fff; }
    .home-campaign-image { min-height: 160px; }
    .home-campaign-image-link .home-campaign-photo { object-fit: contain; }
    .home-campaign-copy { padding-inline: 0; }
    .home-campaign-controls .campaign-arrow { top: auto; bottom: 10px; transform: none; width: 44px; height: 44px; }
    .campaign-arrow[data-step="-1"] { inset-inline-start: 6px; }
    .campaign-arrow[data-step="1"] { inset-inline-end: 6px; }
  }
</style>
