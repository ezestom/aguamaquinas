---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { categories, conditions, formats, provinces } from '../lib/catalog.mjs';
import { FormError, startListingUpload, submitMachine, text, UploadLimitError } from '../lib/submissions.mjs';
import { listingVerification, verificationCookie } from '../lib/listing-verification.mjs';
import { deliverNotification } from '../lib/mail.mjs';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const receipt = Astro.url.searchParams.get('enviada') ?? '';
const sent = Astro.request.method === 'GET' && /^AM-[A-F0-9]{10}$/.test(receipt) ? receipt : '';
const token = Astro.cookies.get(verificationCookie)?.value;
const verified = listingVerification(token);
if (!sent && !verified?.verified_at) return Astro.redirect('/publicar/verificar', 303);

let form;
let error = '';
if (Astro.request.method === 'POST') {
  let release;
  try {
    release = startListingUpload();
    form = await Astro.request.formData();
    const ref = await submitMachine(form, token);
    Astro.cookies.delete(verificationCookie, { path: '/publicar' });
    release();
    release = undefined;
    await deliverNotification(`aviso/${ref}`);
    return Astro.redirect(`/publicar?enviada=${ref}`, 303);
  } catch (failure) {
    if (!(failure instanceof FormError)) console.error(failure);
    error = failure instanceof FormError ? failure.message : 'No se pudo guardar el aviso. Revisá los archivos y probá de nuevo.';
    Astro.response.status = failure instanceof UploadLimitError ? failure.status : failure instanceof FormError ? 400 : 500;
    if (failure instanceof UploadLimitError && failure.retryAfter) Astro.response.headers.set('Retry-After', String(failure.retryAfter));
  } finally {
    release?.();
  }
}
const value = (field) => text(form, field, 1600);
---
<Layout title="Publicar una máquina" page="publicar">
  <div class="wrap interior form-interior">
    <a class="back-link" href="/"><Icon name="back" size={18} /> Volver al catálogo</a>
    <header class="page-heading"><h1>{sent ? 'Aviso recibido' : 'Publicá tu máquina gratis'}</h1>{!sent && <p>Paso 2 de 2 · Agregá los datos y las fotos del equipo para que podamos revisar el aviso.</p>}</header>
    <div class="form-card">
      {sent ? <><p class="message" role="status">Tu aviso <strong>{sent}</strong> quedó pendiente de revisión.</p><a class="button button-primary" href="/">Volver al catálogo</a></> : <>
        {error && <p class="message message-error" role="alert">{error} Volvé a seleccionar las fotos antes de enviar.</p>}
        <form class="form-stack" id="listing" method="post" enctype="multipart/form-data" data-astro-reload>
          <fieldset><legend>1. Datos del equipo</legend>
            <label>Título del aviso<input name="title" required maxlength="90" placeholder="Ej. Lavadora de bidones de 20 L" value={value('title')} /></label>
            <div class="field-grid">
              <label>Categoría<select name="category" required><option value="">Elegí una categoría</option>{Object.entries(categories).map(([key, label]) => <option value={key} selected={value('category') === key}>{label}</option>)}</select></label>
              <label>Provincia<select name="province" required><option value="">Elegí la provincia</option>{provinces.map(province => <option value={province} selected={value('province') === province}>{province}</option>)}</select></label>
              <label>Formato<select name="format" required><option value="">Elegí un formato</option>{Object.entries(formats).map(([key, label]) => <option value={key} selected={value('format') === key}>{label}</option>)}</select></label>
              <label>Estado<select name="condition" required><option value="">Elegí el estado</option>{Object.entries(conditions).map(([key, label]) => <option value={key} selected={value('condition') === key}>{label}</option>)}</select></label>
              <label>Marca <small>Opcional</small><input name="brand" maxlength="60" value={value('brand')} /></label>
              <label>Modelo <small>Opcional</small><input name="model" maxlength="60" value={value('model')} /></label>
              <label>Medida del envase <small>Opcional</small><input name="format_detail" maxlength="70" placeholder="Ej. 12 y 20 L" value={value('format_detail')} /></label>
              <label>Capacidad <small>Opcional</small><input name="capacity" maxlength="60" placeholder="Ej. 120 bidones/h" value={value('capacity')} /></label>
            </div>
            <label>Descripción<textarea name="description" required maxlength="1600" placeholder="Contá qué incluye y si se puede ver funcionando.">{value('description')}</textarea></label>
          </fieldset>
          <fieldset><legend>2. Fotos y enlace de video</legend>
            <div class="photo-field">
              <p id="photo-hint" class="field-hint">Mostrá el equipo completo, la placa y el área de trabajo. Evitá que se vean teléfonos o direcciones.</p>
              <label class="photo-picker" id="photo-picker">
                <input type="file" name="photos" id="photos" class="sr-only" multiple required accept="image/jpeg,image/png,image/webp" aria-describedby="photo-hint photo-formats" />
                <span class="photo-picker-icon"><Icon name="camera" size={23} /></span>
                <span><strong>Agregar fotos</strong><small class="photo-drop-hint">Arrastralas acá o hacé clic para elegirlas.</small><small id="photo-formats">De 1 a 5 en JPG, PNG o WebP · Hasta 3 MB por foto</small></span>
              </label>
              <p class="field-hint" id="photo-status" role="status"></p>
              <div id="photos-preview" class="preview-images" aria-label="Vista previa de las fotos"></div>
            </div>
            <label>Enlace de video <small>Opcional · YouTube o Vimeo</small><input type="url" name="video" maxlength="300" placeholder="https://www.youtube.com/watch?v=…" value={value('video')} /></label>
          </fieldset>
          <fieldset><legend>3. Precio</legend>
            <p class="field-hint">Ingresá un precio fijo o un rango en dólares. Si dejás ambos campos vacíos, la ficha mostrará «Consultar precio».</p>
            <div class="field-grid">
              <label>Precio fijo o desde (USD)<input name="price" type="number" min="1" max="99999999999" step="1" placeholder="Ej. 12500" value={value('price')} /></label>
              <label>Hasta (USD) <small>Solo para un rango</small><input name="price_max" type="number" min="1" max="99999999999" step="1" placeholder="Ej. 15000" value={value('price_max')} /></label>
            </div>
          </fieldset>
          <fieldset><legend>4. Contacto para la gestión del aviso</legend>
            <p class="field-hint">Usamos estos datos para revisar el aviso, gestionar consultas y pedirte que confirmes la disponibilidad del equipo. Solo se ven en el panel de gestión.</p>
            <div class="field-grid">
              <label>Nombre y apellido<input name="seller" required maxlength="80" autocomplete="name" value={value('seller')} /></label>
              <label>WhatsApp o teléfono <small>Incluí el código de país.</small><input name="phone" type="tel" required maxlength="30" autocomplete="tel" placeholder="Ej. +54 9 …" value={value('phone')} /></label>
              <label>Localidad del equipo<input name="locality" required maxlength="80" autocomplete="address-level2" value={value('locality')} /></label>
              <label>Dirección del equipo<input name="address" required maxlength="160" autocomplete="street-address" value={value('address')} /></label>
            </div>
            <p class="listing-verified"><Icon name="check" size={18} /><span><strong>Email verificado</strong> · {verified?.email}</span></p>
          </fieldset>
          <button class="button button-outline" id="show-preview" type="button" hidden>Ver vista previa</button>
          <div class="form-preview" id="listing-preview" tabindex="-1" hidden><p class="eyebrow">Vista previa del aviso</p><strong></strong><p data-summary></p><p data-description></p></div>
          <button class="button button-primary" type="submit">Enviar a revisión <Icon name="arrow" size={18} /></button>
        </form>
      </>}
    </div>
  </div>
  <script>
    import { priceLabel } from '../lib/catalog.mjs';

    document.addEventListener('astro:page-load', () => {
      const input = document.querySelector<HTMLInputElement>('#photos');
      const thumbs = document.querySelector('#photos-preview');
      const status = document.querySelector('#photo-status');
      const picker = document.querySelector('#photo-picker');
      const form = document.querySelector<HTMLFormElement>('#listing');
      const button = document.querySelector<HTMLButtonElement>('#show-preview');
      const preview = document.querySelector<HTMLElement>('#listing-preview');
      if (!input || !thumbs || !status || !picker || !form || !button || !preview) return;

      const photos: { file: File; url: string }[] = [];
      const allowedTypes = input.accept.split(',');
      const sameFile = (a: File, b: File) =>
        a.name === b.name && a.size === b.size && a.lastModified === b.lastModified;
      const renderPhotos = (message = '') => {
        const transfer = new DataTransfer();
        for (const photo of photos) transfer.items.add(photo.file);
        input.files = transfer.files;
        status.classList.toggle('photo-error', Boolean(message));
        status.textContent = [`${photos.length} de 5 fotos`, message].filter(Boolean).join(' · ');
        thumbs.replaceChildren(...photos.map(({ file, url }, index) => {
          const thumb = document.createElement('div');
          thumb.className = 'photo-thumb';
          const image = new Image();
          image.src = url;
          image.alt = `Foto ${index + 1}`;
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '×';
          remove.setAttribute('aria-label', `Quitar foto ${index + 1}: ${file.name}`);
          remove.addEventListener('click', () => {
            URL.revokeObjectURL(url);
            photos.splice(index, 1);
            renderPhotos();
            const buttons = thumbs.querySelectorAll<HTMLButtonElement>('button');
            (buttons[Math.min(index, buttons.length - 1)] ?? input).focus();
          });
          thumb.append(image, remove);
          return thumb;
        }));
      };
      const addPhotos = (files: FileList | null) => {
        const messages = new Set<string>();
        for (const file of Array.from(files ?? [])) {
          if (!file.size || file.size > 3 * 1024 * 1024 || !allowedTypes.includes(file.type)) {
            messages.add('Elegí fotos JPG, PNG o WebP de hasta 3 MB.');
          } else if (!photos.some(photo => sameFile(photo.file, file))) {
            if (photos.length < 5) photos.push({ file, url: URL.createObjectURL(file) });
            else messages.add('Alcanzaste el máximo. Quitá una foto para agregar otra.');
          }
        }
        renderPhotos([...messages].join(' '));
      };
      input.addEventListener('change', () => addPhotos(input.files));
      picker.addEventListener('dragover', event => {
        if (!event.dataTransfer?.types.includes('Files')) return;
        event.preventDefault();
        event.dataTransfer.dropEffect = 'copy';
        picker.classList.add('is-dragging');
      });
      picker.addEventListener('dragleave', event => {
        if (!(event.relatedTarget instanceof Node) || !picker.contains(event.relatedTarget)) picker.classList.remove('is-dragging');
      });
      picker.addEventListener('drop', event => {
        picker.classList.remove('is-dragging');
        if (!event.dataTransfer?.files.length) return;
        event.preventDefault();
        addPhotos(event.dataTransfer.files);
      });
      document.addEventListener('astro:before-swap', () => photos.forEach(photo => URL.revokeObjectURL(photo.url)), { once: true });
      addPhotos(input.files);
      button.hidden = false;
      button.addEventListener('click', () => {
        const fields = new FormData(form);
        preview.querySelector('strong')!.textContent = String(fields.get('title') || 'Título del equipo');
        const amount = priceLabel({ price: Number(fields.get('price')), price_max: Number(fields.get('price_max')), currency: 'USD' });
        preview.querySelector('[data-summary]')!.textContent = [fields.get('province'), fields.get('capacity'), amount].filter(Boolean).join(' · ');
        preview.querySelector('[data-description]')!.textContent = String(fields.get('description') || 'Agregá una descripción para completar el aviso.');
        preview.hidden = false;
        preview.focus();
      });
    });
  </script>
</Layout>

<style>
  .listing-verified { display: flex; align-items: start; gap: 8px; color: var(--success-ink); overflow-wrap: anywhere; }
  .listing-verified svg { flex: none; margin-top: 3px; }
  .photo-drop-hint { margin-block: 3px; }
  #photos-preview :global(.photo-thumb) { position: relative; }
  #photos-preview :global(img) { display: block; width: 96px; height: 76px; border-radius: var(--radius); }
  #photos-preview :global(button) {
    position: absolute;
    inset: 3px 3px auto auto;
    width: 34px;
    height: 34px;
    border-radius: var(--radius);
    color: #fff;
    background: #14243a;
    font-size: 1.25rem;
    line-height: 1;
  }
</style>
