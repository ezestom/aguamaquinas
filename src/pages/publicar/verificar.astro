---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { codeSeconds, issueListingCode, listingVerification, verificationCookie,
  verificationSeconds, VerificationError, verifyListingCode } from '../../lib/listing-verification.mjs';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const token = Astro.cookies.get(verificationCookie)?.value;
const verification = listingVerification(token);
const changing = Astro.url.searchParams.has('cambiar');
let email = verification?.email ?? '';
let error = '';
const setCookie = (value: string, maxAge: number) => Astro.cookies.set(verificationCookie, value, {
  path: '/publicar', httpOnly: true, sameSite: 'strict', secure: Astro.url.protocol === 'https:', maxAge,
});

if (Astro.request.method === 'POST') {
  try {
    const type = Astro.request.headers.get('content-type')?.split(';')[0];
    if (type !== 'application/x-www-form-urlencoded') throw new VerificationError('Volvé a cargar el formulario.');
    const decoder = new TextDecoder();
    const reader = Astro.request.body?.getReader();
    let payload = '';
    let bytes = 0;
    if (reader) {
      for (let chunk = await reader.read(); !chunk.done; chunk = await reader.read()) {
        bytes += chunk.value.byteLength;
        if (bytes > 2048) {
          void reader.cancel().catch(() => {});
          throw new VerificationError('El formulario es demasiado largo.', 413);
        }
        payload += decoder.decode(chunk.value, { stream: true });
      }
      payload += decoder.decode();
    }
    const form = new URLSearchParams(payload);
    if (form.get('action') === 'verify' && token) {
      verifyListingCode(token, form.get('code')?.trim() ?? '');
      setCookie(token, verificationSeconds);
      return Astro.redirect('/publicar', 303);
    }
    if (form.get('action') === 'send') {
      email = form.get('email') ?? verification?.email ?? '';
      setCookie(await issueListingCode(email, token), codeSeconds);
      return Astro.redirect('/publicar/verificar', 303);
    }
    throw new VerificationError('Pedí un nuevo código para continuar.');
  } catch (failure) {
    error = failure instanceof VerificationError ? failure.message : 'No pudimos completar la verificación. Probá de nuevo.';
    Astro.response.status = failure instanceof VerificationError ? failure.status : 500;
  }
} else if (verification?.verified_at && !changing) {
  return Astro.redirect('/publicar', 303);
}
const awaitingCode = verification && !changing && !verification.verified_at;
---
<Layout title="Verificá tu email para publicar" page="publicar">
  <div class="wrap interior form-interior verification-flow">
    <a class="back-link" href="/"><Icon name="back" size={18} /> Volver al catálogo</a>
    <ol class="verification-steps" aria-label="Pasos para publicar">
      <li aria-current="step"><span>1</span> Verificar email</li>
      <li><span>2</span> Cargar aviso</li>
    </ol>
    <header class="page-heading">
      <h1>{awaitingCode ? 'Ingresá el código' : 'Verificá tu email'}</h1>
      <p>{awaitingCode ? 'Ingresá los seis dígitos para continuar con tu aviso.' : 'Te mandamos un código de seis dígitos para que puedas cargar tu aviso.'}</p>
    </header>
    <div class="form-card verification-card">
      {error && <p class="message message-error" role="alert">{error}</p>}
      {awaitingCode ? <>
        <form method="post" class="form-stack" data-astro-reload>
          <div class="verification-recipient">
            <Icon name="check" size={18} />
            <p>Código enviado a <strong class="verification-email">{verification.email}</strong><small id="code-help">Vence a los 10 minutos del envío.</small></p>
          </div>
          <input type="hidden" name="action" value="verify" />
          <label for="verification-code">Código de seis dígitos</label>
          <input id="verification-code" class="verification-code" name="code" type="text" inputmode="numeric"
            autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" aria-describedby="code-help" required />
          <button type="submit" class="button button-primary">Verificar y continuar <Icon name="arrow" size={18} /></button>
        </form>
        <form method="post" class="verification-actions" data-astro-reload>
          <p>¿No te llegó? Revisá también la carpeta de spam.</p>
          <button type="submit" class="button button-outline" name="action" value="send">Reenviar código</button>
          <a href="/publicar/verificar?cambiar=1">Cambiar email</a>
        </form>
      </> : <form method="post" class="form-stack" data-astro-reload>
        <input type="hidden" name="action" value="send" />
        <label>Email<input type="email" name="email" value={email} autocomplete="email" maxlength="254" placeholder="nombre@ejemplo.com" aria-describedby="email-help" required /></label>
        <p id="email-help" class="field-hint">Tu email solo queda en el panel de gestión.</p>
        <button type="submit" class="button button-primary">Enviarme el código <Icon name="arrow" size={18} /></button>
      </form>}
    </div>
  </div>
</Layout>

<style>
  .verification-flow { max-width: 560px; }
  .verification-steps { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 0 0 16px; padding: 0; list-style: none; }
  .verification-steps li { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); font-size: .875rem; font-weight: 650; }
  .verification-steps span { display: grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .verification-steps li[aria-current] { color: var(--deep); }
  .verification-steps li[aria-current] span { color: #fff; background: var(--primary); border-color: var(--primary); }
  .verification-card > .message { margin-bottom: 16px; }
  .verification-email { overflow-wrap: anywhere; }
  .verification-recipient { display: flex; align-items: start; gap: 9px; padding: 12px; border-radius: var(--radius); background: var(--subtle); }
  .verification-recipient svg { flex: none; margin-top: 3px; color: var(--primary); }
  .verification-recipient small { display: block; color: var(--muted); }
  .form-stack .verification-code {
    width: min(100%, 15rem);
    font-size: 1.375rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .35em;
  }
  .verification-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  .verification-actions p { flex-basis: 100%; font-size: .875rem; color: var(--muted); }
  .verification-actions a { color: var(--deep); text-underline-offset: 3px; }
</style>
