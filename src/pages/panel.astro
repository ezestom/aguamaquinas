---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PanelDialog from '../components/PanelDialog.astro';
import { adminKey, adminSessionCookie, adminSessionSeconds, createAdminSession, db, hasAdminSession, revokeAdminSession, safeEqual } from '../lib/db.mjs';
import { categories, priceLabel } from '../lib/catalog.mjs';
import { FormError, submitInquiry, text } from '../lib/submissions.mjs';
import { applyPanelChange, listingStatuses, managedInquiries, managedListings, managedRecord } from '../lib/listing-management.mjs';
import { inquirySources, inquiryStages, moneyLabel } from '../lib/inquiry-options.mjs';
import { availabilitySeconds } from '../lib/availability.mjs';
import { retryNotifications } from '../lib/mail.mjs';
import '../styles/admin.css';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const sections = { avisos: 'Avisos', vendedores: 'Vendedores', consultas: 'Consultas web', papelera: 'Papelera' };
const query = Astro.url.searchParams;
const requestedSection = query.get('vista') ?? '';
const section = Object.hasOwn(sections, requestedSection) ? requestedSection : 'avisos';
const manualChannel = section === 'consultas' && query.get('canal') === 'manual';
const requestedStatus = query.get('estado') ?? '';
const statuses = section === 'consultas' ? inquiryStages : listingStatuses;
const status = Object.hasOwn(statuses, requestedStatus) ? requestedStatus : '';
const search = (query.get('q') ?? '').trim().slice(0, 100);
const pageNumber = Math.max(1, parseInt(query.get('pagina') ?? '1', 10) || 1);
const operation = query.get('accion') ?? '';
const kind = query.get('tipo') === 'consulta' ? 'consulta' : 'aviso';
const key = (query.get('id') ?? '').slice(0, 32);
const operations = kind === 'consulta' ? ['view', 'edit', 'delete', 'restore', 'followup']
  : ['view', 'edit', 'seller', 'delete', 'restore', 'published', 'paused', 'sold', 'confirm'];

function panelUrl(options: Record<string, string | number> = {}) {
  const params = new URLSearchParams();
  if (section !== 'avisos') params.set('vista', section);
  if (manualChannel) params.set('canal', 'manual');
  if (search) params.set('q', search);
  if (['avisos', 'consultas'].includes(section) && status) params.set('estado', status);
  if (pageNumber > 1) params.set('pagina', String(pageNumber));
  for (const [name, value] of Object.entries(options)) {
    if (value) params.set(name, String(value));
    else params.delete(name);
  }
  return '/panel' + (params.size ? '?' + params : '');
}

const openDialog = (action: string, type: string, id: string | number) => panelUrl({ accion: action, tipo: type, id });
const messages = {
  edit: 'Cambios guardados.', seller: 'Datos del vendedor actualizados.', delete: 'Registro movido a la papelera.',
  restore: 'Registro restaurado.', published: 'Aviso publicado.', paused: 'Aviso pausado.', sold: 'Aviso marcado como vendido.',
  followup: 'Seguimiento actualizado.', 'new-inquiry': 'Consulta registrada.', confirm: 'Disponibilidad confirmada.',
};
const notice = query.get('resultado') ?? '';
const token = Astro.cookies.get(adminSessionCookie)?.value;
const adminPassword = adminKey();
const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const authorized = hasAdminSession(token);
let error = '';
let submitted: FormData | undefined;
let manualForm: FormData | undefined;
const recordForDialog = () => {
  if (!authorized || !operations.includes(operation)) return;
  const record = managedRecord(kind, key);
  if (record && Boolean(record.deleted_at) === (operation === 'restore')) return record;
};
if (form) {
  const action = text(form, 'action', 15);
  if (action === 'login') {
    if (safeEqual(text(form, 'key', 250), adminPassword)) {
      Astro.cookies.set(adminSessionCookie, createAdminSession(), {
        path: '/', maxAge: adminSessionSeconds, httpOnly: true, sameSite: 'strict', secure: Astro.url.protocol === 'https:',
      });
      return Astro.redirect('/panel', 303);
    }
    error = 'La clave no coincide.';
    Astro.response.status = 401;
  } else if (!authorized) {
    error = 'Ingresá al panel para continuar.';
    Astro.response.status = 403;
  } else if (action === 'logout') {
    revokeAdminSession(token);
    Astro.cookies.delete(adminSessionCookie, { path: '/' });
    return Astro.redirect('/panel', 303);
  } else if (action === 'retry-mail') {
    await retryNotifications();
    return Astro.redirect(panelUrl(), 303);
  } else if (action === 'new-inquiry' && manualChannel) {
    try {
      const source = text(form, 'origin', 32);
      if (!Object.hasOwn(inquirySources, source)) throw new FormError('Elegí el origen de la consulta.');
      submitInquiry(form, text(form, 'reference', 32).toUpperCase(), source, true);
      return Astro.redirect('/panel?vista=consultas&canal=manual&resultado=new-inquiry', 303);
    } catch (failure) {
      error = failure instanceof FormError ? failure.message : 'No pudimos registrar la consulta. Probá de nuevo.';
      if (!(failure instanceof FormError)) console.error(failure);
      Astro.response.status = failure instanceof FormError ? failure.status : 500;
      manualForm = form;
    }
  } else if (action === 'apply') {
    try {
      if (!recordForDialog() || operation === 'view') throw new FormError('El registro ya no está disponible.', 409);
      applyPanelChange(kind, key, operation, form);
      return Astro.redirect(panelUrl({ resultado: operation }), 303);
    } catch (failure) {
      error = failure instanceof FormError ? failure.message : 'No pudimos guardar los cambios. Probá de nuevo.';
      if (!(failure instanceof FormError)) console.error(failure);
      Astro.response.status = failure instanceof FormError ? failure.status : 500;
      if (Astro.response.status === 400) submitted = form;
    }
  }
}
const selected = recordForDialog();
const listings = authorized ? managedListings() : [];
const inquiries = authorized ? managedInquiries() : [];
const webCount = inquiries.filter(item => !item.manual).length;
const trashed = authorized ? [
  ...managedListings(true).map(record => ({ ...record, kind: 'aviso', key: record.ref })),
  ...managedInquiries(true).map(record => ({ ...record, kind: 'consulta', key: record.id })),
].sort((a, b) => b.deleted_at - a.deleted_at) : [];
const fold = (value: string) => value.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
const terms = fold(search).split(/\s+/).filter(Boolean);
const matches = (...values: unknown[]) => {
  const haystack = fold(values.join(' '));
  return terms.every(term => haystack.includes(term));
};
const visibleListings = listings.filter(item => (!status || section !== 'avisos' || item.status === status)
  && matches(item.ref, item.title, item.seller, item.email, item.phone, item.contact, item.locality, item.address, item.province, categories[item.category], item.brand, item.model));
const visibleInquiries = inquiries.filter(item => (section !== 'consultas' || !status || item.stage === status)
  && Boolean(item.manual) === manualChannel
  && matches(item.name, item.contact, item.buyer_email, item.buyer_whatsapp, item.message, item.machine_title, item.machine_ref, item.origin, item.location));
const visibleTrash = trashed.filter(item => matches(item.title, item.name, item.seller, item.ref));
const resultCount = section === 'consultas' ? visibleInquiries.length : section === 'papelera' ? visibleTrash.length : visibleListings.length;
const perPage = 20;
const totalPages = Math.max(1, Math.ceil(resultCount / perPage));
const currentPage = Math.min(pageNumber, totalPages);
const offset = (currentPage - 1) * perPage;
const pageRows = <T,>(items: T[]) => items.slice(offset, offset + perPage);
const pendingMail = authorized ? db().prepare('SELECT count(*) AS count FROM notification_outbox WHERE sent_at IS NULL').get().count : 0;
const date = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires' });
const dueBefore = Math.floor(Date.now() / 1000) - availabilitySeconds;
---

<Layout title="Panel de Agua Máquinas" page="panel">
  <div class="wrap interior admin-workspace">
    <a class="back-link" href="/"><Icon name="back" size={17} /> Volver al catálogo</a>
    <header class="admin-header">
      <div><h1>Panel de Agua Máquinas</h1><p>Gestioná los equipos, sus vendedores y las consultas desde un mismo lugar.</p></div>
      {authorized && <div class="admin-header-actions">
        <a class="button button-outline" href="/panel/portada">Gestionar portada</a>
        <a class="button button-outline" href={section === 'consultas' ? '/panel/consultas.csv?canal=' + (manualChannel ? 'manual' : 'web') : '/panel/avisos.csv'} data-astro-reload download>
          <Icon name="download" size={17} /> {section === 'consultas' ? 'Exportar consultas' : 'Exportar avisos'}
        </a>
        <form method="post" action="/panel" data-astro-reload><button class="button button-outline" name="action" value="logout">Cerrar sesión</button></form>
      </div>}
    </header>

    {error && !selected && <p class="message message-error admin-feedback" role="alert">{error}</p>}
    {authorized ? <>
      {Object.hasOwn(messages, notice) && <p class="message admin-feedback" role="status"><Icon name="check" size={17} /> {messages[notice]}</p>}
      {pendingMail > 0 && <form class="admin-mail" method="post" action={panelUrl()} data-astro-reload>
        <p>{pendingMail} {pendingMail === 1 ? 'alerta de correo pendiente' : 'alertas de correo pendientes'}</p>
        <button class="button button-outline" name="action" value="retry-mail">Reintentar envío</button>
      </form>}

      {selected && <PanelDialog record={selected} kind={kind} operation={operation}
        closeUrl={panelUrl() + '#registro-' + kind + '-' + key} actionUrl={openDialog(operation, kind, key)}
        error={error} submitted={submitted} link={openDialog} />}

      <section class="admin-sheet" aria-label="Planilla de gestión">
        <nav class="admin-tabs" aria-label="Vistas de la planilla">
          {Object.entries(sections).map(([id, label]) => (
            <a href={id === 'avisos' ? '/panel' : '/panel?vista=' + id} aria-current={section === id ? 'page' : undefined}>
              {label}<span>{id === 'consultas' ? webCount : id === 'papelera' ? trashed.length : listings.length}</span>
            </a>
          ))}
        </nav>
        {section === 'consultas' && <nav class="inquiry-channels" aria-label="Canal de consultas">
          <a href="/panel?vista=consultas" aria-current={!manualChannel ? 'page' : undefined}>Web ({webCount})</a>
          <a href="/panel?vista=consultas&canal=manual" aria-current={manualChannel ? 'page' : undefined}>Registro manual ({inquiries.length - webCount})</a>
        </nav>}
        {manualChannel && <details class="admin-manual-inquiry" open={Boolean(manualForm)}>
          <summary>Registrar consulta</summary>
          <form class="form-stack" action={panelUrl()} method="post" data-astro-reload>
            <input type="hidden" name="action" value="new-inquiry" />
            <div class="admin-fields">
              <label>Nombre<input name="name" required maxlength="80" value={text(manualForm, 'name', 80)} /></label>
              <label>Teléfono o correo<input name="contact" required maxlength="100" value={text(manualForm, 'contact', 100)} /></label>
              <label>Origen<select name="origin" required><option value="">Elegí un canal</option>
                {Object.entries(inquirySources).map(([id, label]) => <option value={id} selected={manualForm?.get('origin') === id}>{label}</option>)}
              </select></label>
              <label>Referencia del aviso <small>Opcional</small><input name="reference" maxlength="32" value={text(manualForm, 'reference', 32)} /></label>
              <label class="admin-field-wide">Consulta<textarea name="message" required maxlength="1200">{text(manualForm, 'message', 1200)}</textarea></label>
            </div>
            <button class="button button-primary" type="submit">Guardar consulta</button>
          </form>
        </details>}
        <form class="admin-filters" action="/panel" method="get" data-panel-filters>
          {section !== 'avisos' && <input type="hidden" name="vista" value={section} />}
          {manualChannel && <input type="hidden" name="canal" value="manual" />}
          <label class="admin-search"><Icon name="search" size={18} /><span class="visually-hidden">Buscar en {sections[section]}</span><input name="q" value={search} maxlength="100" type="search" placeholder={section === 'consultas' ? 'Buscar por cliente o equipo' : 'Buscar por equipo o vendedor'} /></label>
          {['avisos', 'consultas'].includes(section) && <label class="admin-filter-status"><span class="visually-hidden">Estado {section === 'avisos' ? 'del aviso' : 'de la consulta'}</span><select name="estado"><option value="">Todos los estados</option>{Object.entries(statuses).map(([id, label]) => <option value={id} selected={id === status}>{label}</option>)}</select></label>}
          <button class="button button-outline" type="submit">Aplicar filtros</button>
          {(search || status) && <a class="admin-clear" href={panelUrl({ q: '', estado: '', pagina: '' })}>Limpiar</a>}
        </form>

        {resultCount ? <div class="admin-table-scroll" tabindex="0" role="region" aria-label={'Tabla de ' + sections[section].toLowerCase()}>
          <table class="admin-table">
            <thead><tr>
              {section === 'avisos' ? <><th scope="col">Equipo</th><th scope="col">Vendedor</th><th scope="col">Estado</th><th scope="col">Precio</th></>
                : section === 'vendedores' ? <><th scope="col">Vendedor</th><th scope="col">Equipo</th><th scope="col">Contacto</th><th scope="col">Ubicación</th></>
                : section === 'consultas' ? <><th scope="col">Cliente</th><th scope="col">Equipo</th><th scope="col">Estado</th><th scope="col">Ingreso</th></>
                : <><th scope="col">Registro</th><th scope="col">Tipo</th><th scope="col">Enviado a la papelera</th></>}
              <th scope="col">Acciones</th>
            </tr></thead>
            <tbody>
              {(section === 'avisos' || section === 'vendedores') && pageRows(visibleListings).map(item => (
                <tr id={'registro-aviso-' + item.ref} tabindex="-1">
                  {section === 'avisos' ? <>
                    <th scope="row"><a class="admin-row-title" href={openDialog('view', 'aviso', item.ref)}>{item.title}</a><small>{item.ref} · {categories[item.category]}</small></th>
                    <td>{item.seller || 'Sin nombre'}<small>{item.verified_at ? 'Email verificado' : 'Email sin verificar'}</small></td>
                    <td><span class="admin-state" data-status={item.status}>{listingStatuses[item.status]}</span>
                      {item.status === 'published' && (!item.confirmed_at || item.confirmed_at <= dueBefore) && <small>Por reconfirmar</small>}
                    </td>
                    <td class="admin-price">{priceLabel(item)}</td>
                  </> : <>
                    <th scope="row"><a class="admin-row-title" href={openDialog('view', 'aviso', item.ref)}>{item.seller || 'Sin nombre'}</a><small>{item.verified_at ? 'Email verificado' : 'Email sin verificar'}</small></th>
                    <td>{item.title}<small>{item.ref}</small></td><td>{item.email || item.contact || '—'}{item.phone && <small>{item.phone}</small>}</td>
                    <td>{[item.address, item.locality].filter(Boolean).join(', ') || '—'}<small>{item.province}</small></td>
                  </>}
                  <td><div class="admin-row-actions">
                    {section === 'avisos' && item.status === 'pending' && item.verified_at > 0 &&
                      <a class="admin-icon-action admin-publish" href={openDialog('published', 'aviso', item.ref)}
                        aria-label={'Publicar ' + item.title}><Icon name="check" size={17} /> Publicar</a>}
                    <a class="admin-icon-action" href={openDialog(section === 'vendedores' ? 'seller' : 'edit', 'aviso', item.ref)} aria-label={'Editar ' + (section === 'vendedores' ? item.seller || 'vendedor' : item.title)} title="Editar"><Icon name="edit" size={17} /><span>Editar</span></a>
                    {section === 'avisos' && <a class="admin-icon-action admin-danger-link" href={openDialog('delete', 'aviso', item.ref)} aria-label={'Eliminar ' + item.title} title="Eliminar aviso"><Icon name="trash" size={17} /></a>}
                  </div></td>
                </tr>
              ))}
              {section === 'consultas' && pageRows(visibleInquiries).map(item => (
                <tr id={'registro-consulta-' + item.id} tabindex="-1">
                  <th scope="row"><a class="admin-row-title" href={openDialog('view', 'consulta', item.id)}>{item.name}</a>
                    <small>{[item.origin, item.contact].filter(Boolean).join(' · ')}</small>
                    {item.buyer_whatsapp && <small>{item.buyer_whatsapp}</small>}
                    {item.buyer_email && <small>{item.buyer_email}</small>}
                  </th>
                  <td>{item.machine_title ?? (item.machine_ref || 'Pedido general')}{item.machine_ref && <small>{item.machine_ref}</small>}</td>
                  <td><span class="admin-state" data-status={item.stage}>{inquiryStages[item.stage]}</span>
                    {item.commission_paid != null && <small>Cobrado · {moneyLabel(item.commission_paid, item.commission_currency)}</small>}
                  </td><td>{date.format(new Date(item.created_at.replace(' ', 'T') + 'Z'))}</td>
                  <td><div class="admin-row-actions">
                    <a class="admin-icon-action" href={openDialog('followup', 'consulta', item.id)} aria-label={'Seguimiento de ' + item.name} title="Actualizar seguimiento"><Icon name="edit" size={17} /><span>Seguimiento</span></a>
                    <a class="admin-icon-action admin-danger-link" href={openDialog('delete', 'consulta', item.id)} aria-label={'Eliminar consulta de ' + item.name} title="Eliminar consulta"><Icon name="trash" size={17} /></a>
                  </div></td>
                </tr>
              ))}
              {section === 'papelera' && pageRows(visibleTrash).map(item => (
                <tr id={'registro-' + item.kind + '-' + item.key} tabindex="-1">
                  <th scope="row">{item.title ?? item.name}<small>{item.ref ?? 'Consulta #' + item.id}</small></th>
                  <td>{item.kind === 'aviso' ? 'Aviso' : 'Consulta'}</td><td>{date.format(item.deleted_at * 1000)}</td>
                  <td><a class="admin-icon-action" href={openDialog('restore', item.kind, item.key)}><Icon name="restore" size={17} /> Restaurar</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div> : <div class="admin-empty">
          <Icon name={section === 'papelera' ? 'trash' : 'list'} size={26} />
          <h2>{search || status ? 'No encontramos coincidencias' : section === 'papelera' ? 'La papelera está vacía' : 'Todavía no hay registros'}</h2>
          <p>{search || status ? 'Probá con otro término o limpiá los filtros.' : section === 'papelera' ? 'Los avisos y las consultas que elimines aparecerán acá.' : 'Las publicaciones y consultas nuevas aparecerán en su sección.'}</p>
        </div>}
        <footer class="admin-table-footer">
          <p>{resultCount ? (offset + 1) + '–' + Math.min(offset + perPage, resultCount) + ' de ' + resultCount : '0 registros'}</p>
          {totalPages > 1 && <nav aria-label="Paginación">
            {currentPage > 1 && <a class="button button-outline" href={panelUrl({ pagina: currentPage - 1 })}>Anterior</a>}
            <span>{currentPage} de {totalPages}</span>
            {currentPage < totalPages && <a class="button button-outline" href={panelUrl({ pagina: currentPage + 1 })}>Siguiente</a>}
          </nav>}
        </footer>
      </section>
    </> : <form method="post" class="form-card form-stack admin-login" data-astro-reload>
      <input type="hidden" name="action" value="login" />
      <label>Clave del panel<input type="password" name="key" required maxlength="250" autocomplete="current-password" /></label>
      <button type="submit" class="button button-primary">Ingresar</button>
    </form>}
  </div>
</Layout>

<script>
  import '../components/admin-dialog';

  let restoreFilterFocus = false;
  document.addEventListener('change', event => {
    const select = event.target;
    if (!(select instanceof HTMLSelectElement) || select.name !== 'estado' || !select.form?.matches('[data-panel-filters]')) return;
    restoreFilterFocus = true;
    select.form.requestSubmit();
  });
  document.addEventListener('astro:page-load', () => {
    if (!restoreFilterFocus) return;
    restoreFilterFocus = false;
    document.querySelector<HTMLSelectElement>('[data-panel-filters] select[name="estado"]')?.focus({ preventScroll: true });
  });
</script>

<style>
  .inquiry-channels { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 8px 18px 0; font-size: .875rem; }
  .inquiry-channels a { display: inline-flex; align-items: center; min-height: 38px; color: var(--muted); }
  .inquiry-channels a[aria-current] { color: var(--deep); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .admin-manual-inquiry { padding: 0 18px 10px; }
  .admin-manual-inquiry summary { color: var(--deep); font-weight: 650; cursor: pointer; width: fit-content; }
  .admin-manual-inquiry form { margin-top: 12px; }
  .admin-state[data-status="closed"] { color: var(--success-ink); background: var(--success-bg); }
  .admin-publish { color: var(--deep); background: var(--tint); border-color: var(--field-border); }
  .admin-publish:hover { color: #fff; background: var(--primary); border-color: var(--primary); }
</style>
