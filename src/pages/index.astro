---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import MachineCard from '../components/MachineCard.astro';
import HomeCarousel from '../components/HomeCarousel.astro';
import CatalogCount from '../components/CatalogCount.astro';
import FeaturedShelf from '../components/FeaturedShelf.astro';
import { categories, conditions, formats, matches, provinces } from '../lib/catalog.mjs';
import { db } from '../lib/db.mjs';
import { featuredLimit, featuredListings, homeCampaigns } from '../lib/home.mjs';
import { referenceEquipment } from '../lib/reference-equipment.mjs';
import { inquirySource } from '../lib/inquiry-options.mjs';

const params = Astro.url.searchParams;
const category = Object.hasOwn(categories, params.get('categoria')) ? params.get('categoria') : '';
const origin = inquirySource(params.get('origen'));
const filters = new URLSearchParams();
for (const key of ['q', 'provincia', 'formato', 'estado']) {
  if (params.get(key)) filters.set(key, params.get(key).slice(0, 120));
}
if (origin) filters.set('origen', origin);
if (category) filters.set('categoria', category);
const catalogFilterGroups = [
  { name: 'provincia', label: 'Provincia', options: [['', 'Todas'], ...provinces.map(province => [province, province])] },
  { name: 'formato', label: 'Formato', options: [['', 'Todos'], ...Object.entries(formats)] },
  { name: 'estado', label: 'Estado', options: [['', 'Todos'], ...Object.entries(conditions)] },
];
function filterUrl(name: string, value: string) {
  const next = new URLSearchParams(filters);
  if (value) next.set(name, value);
  else next.delete(name);
  return '/' + (next.size ? '?' + next : '');
}
const home = [...filters.keys()].every(key => key === 'origen');
const assigned = featuredListings();
const referenceSlots = referenceEquipment.slice(0, featuredLimit - assigned.length);
const featured = Array.from({ length: featuredLimit }, (_, index) =>
  assigned.find(machine => machine.featured_position === index + 1) ?? referenceSlots.shift()
).filter(Boolean);
const featuredRefs = new Set(home ? featured.map(machine => machine.ref) : []);
const publicListings = db().prepare(`SELECT m.*, d.price_max FROM machines m LEFT JOIN listing_details d ON d.machine_ref = m.ref
  WHERE m.status = 'published' AND m.sample = 0 ORDER BY m.id DESC`)
  .all();
const published = publicListings.filter(machine => matches(machine, filters));
const references = referenceEquipment.filter(machine => matches(machine, filters));
const machines = [...published, ...references].filter(machine => !featuredRefs.has(machine.ref));
const publishedCount = published.length;
const referenceCount = references.length;
const count = [publishedCount && `${publishedCount} ${publishedCount === 1 ? 'aviso publicado' : 'avisos publicados'}`,
  referenceCount && `${referenceCount} ${referenceCount === 1 ? 'equipo de referencia' : 'equipos de referencia'}`].filter(Boolean).join(' · ');
const campaigns = homeCampaigns(true);
const inquiryHref = origin ? '/consulta?' + new URLSearchParams({ origen: origin }) : '/consulta';
const categoryOrder = ['', 'lavadoras', 'llenadoras', 'lineas', 'soda', 'tanques', 'tratamiento'];
categoryOrder.push(...Object.keys(categories).filter(key => !categoryOrder.includes(key)));
const fallbackCount = 3;
const categoryUrl = (key) => {
  const next = key ? new URLSearchParams(filters) : new URLSearchParams(origin ? { origen: origin } : {});
  if (key) next.set('categoria', key);
  return `/${next.size ? `?${next}` : ''}`;
};
const currentTab = key => key === category && (key || home) ? 'page' : undefined;
const reset = new URLSearchParams();
if (origin) reset.set('origen', origin);
if (category) reset.set('categoria', category);
if (filters.has('q')) reset.set('q', filters.get('q'));
const filterCount = ['provincia', 'formato', 'estado'].filter(key => filters.has(key)).length;
---
<Layout>
  <div class="catalog-intro">
    <HomeCarousel campaigns={campaigns} inquiryHref={inquiryHref} />
    <CatalogCount total={publicListings.length + referenceEquipment.length} />
    {featured.length > 0 && <FeaturedShelf machines={featured} params={filters} />}
  </div>
  <category-tabs class="category-band" id="explorar">
    <nav class="wrap tabs" aria-label="Categorías de equipos">
      {categoryOrder.map((key, index) => <a class="category-tab" hidden={index >= fallbackCount} href={categoryUrl(key)} aria-current={currentTab(key)}>
        {key ? categories[key] : <><span class="tab-long">Todos los equipos</span><span class="tab-short">Todos</span></>}
      </a>)}
      <details class="more-tabs">
        <summary class:list={['category-tab', categoryOrder.indexOf(category) >= fallbackCount && 'selected']} aria-label="Más categorías"><span class="tab-long">Más categorías</span><span class="tab-short">Más</span></summary>
        <div>{categoryOrder.map((key, index) => <a hidden={index < fallbackCount} href={categoryUrl(key)} aria-current={currentTab(key)}>{key ? categories[key] : 'Todos los equipos'}</a>)}</div>
      </details>
    </nav>
  </category-tabs>
  <section class="wrap catalog" id="catalogo" aria-labelledby="catalog-title">
    <div class="catalog-heading">
      <h1 id="catalog-title">{category ? categories[category] : 'Catálogo de equipos'}</h1>
      <p>{count || '0 equipos'}{filters.get('q') && ` para «${filters.get('q')}»`}</p>
    </div>
    <div class="catalog-controls">
      <form class="catalog-search" action="/" role="search">
        <label for="search">Buscar un equipo</label>
        <div class="search-form">
          <div class="search-input"><Icon name="search" /><input id="search" name="q" type="search" maxlength="120" placeholder="Equipo, marca o ref." value={filters.get('q') ?? ''} /></div>
          {['categoria', 'provincia', 'formato', 'estado', 'origen'].map(key => filters.has(key) && <input type="hidden" name={key} value={filters.get(key)} />)}
          <button class="button button-primary" type="submit">Buscar</button>
        </div>
      </form>
      <details class="filter-box" open>
        <summary>
          <Icon name="filters" size={19} />
          Filtrar equipos
          {filterCount > 0 && <span class="filter-count">{filterCount}<span class="sr-only"> {filterCount === 1 ? 'filtro activo' : 'filtros activos'}</span></span>}
          <span class="filter-chevron"><Icon name="next" size={15} /></span>
        </summary>
        <div class="catalog-filter-grid" role="group" aria-label="Filtros del catálogo">
          {catalogFilterGroups.map(({ name, label, options }) => {
            const active = filters.get(name) ?? '';
            const selected = options.find(([value]) => value === active)?.[1] ?? options[0][1];
            return <div class="catalog-filter">
              <span id={`filter-label-${name}`}>{label}</span>
              <button type="button" class="catalog-filter-trigger" popovertarget={`filter-${name}`} aria-labelledby={`filter-label-${name} filter-value-${name}`}>
                <span id={`filter-value-${name}`}>{selected}</span><span aria-hidden="true"><Icon name="next" size={14} /></span>
              </button>
              <div id={`filter-${name}`} class="catalog-filter-options" popover>
                {options.map(([value, text]) => <a href={filterUrl(name, value)} aria-current={active === value ? 'true' : undefined}>{text}{active === value && <Icon name="check" size={15} />}</a>)}
              </div>
            </div>;
          })}
          <a class:list={['clear-filters', !filterCount && 'clear-filters-inactive']} href={filterCount ? `/${reset.size ? `?${reset}` : ''}` : undefined} aria-hidden={!filterCount || undefined}>Limpiar filtros</a>
        </div>
      </details>
    </div>
    {machines.length > 0 ? <div class="cards">{machines.map((machine, index) => <MachineCard machine={machine} params={filters} priority={!home && index < 3} />)}</div> : !count && <div class="empty"><Icon name="search" size={32} /><h2>No encontramos equipos con esa búsqueda</h2><p>Probá con otra palabra o contanos qué máquina necesitás.</p><a class="button button-primary" href={inquiryHref}>Pedir un equipo</a></div>}
  </section>
  <script>
    import '../components/category-tabs';
    const wideFilters = window.matchMedia('(min-width: 691px)');
    let changedFilter: string | null = null;
    const syncFilters = () => {
      const box = document.querySelector<HTMLDetailsElement>('.filter-box');
      if (!box) return;
      box.open = wideFilters.matches || Boolean(box.querySelector('.filter-count')) || Boolean(changedFilter);
    };
    wideFilters.addEventListener('change', () => syncFilters());
    document.addEventListener('astro:after-swap', () => {
      syncFilters();
      if (changedFilter) document.querySelector<HTMLButtonElement>(`[popovertarget="${changedFilter}"]`)?.focus({ preventScroll: true });
      changedFilter = undefined;
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Element) changedFilter = event.target.closest('.catalog-filter-options a')?.parentElement?.id ?? null;
    });
    syncFilters();
  </script>
</Layout>

<style>
  .catalog-intro {
    --campaign-fade-edge: color-mix(in srgb, #c9e7ff 28%, var(--surface));
  }
</style>
