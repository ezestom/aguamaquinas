---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import InquiryCriteria from '../components/InquiryCriteria.astro';
import { getPhotos } from '../lib/db.mjs';
import { FormError, submitInquiry, text } from '../lib/submissions.mjs';
import { deliverNotification } from '../lib/mail.mjs';
import { inquirySource } from '../lib/inquiry-options.mjs';
import { categories, conditions, formats, priceLabel } from '../lib/catalog.mjs';
import { findPublicEquipment } from '../lib/public-equipment.mjs';

Astro.response.headers.set('Cache-Control', 'private, no-store');
const reference = Astro.url.searchParams.get('equipo') ?? '';
const origin = inquirySource(Astro.url.searchParams.get('origen'));
const sourceQuery = origin ? '?' + new URLSearchParams({ origen: origin }) : '';
let form;
let error = '';
if (Astro.request.method === 'POST') {
  try {
    form = await Astro.request.formData();
    await deliverNotification(submitInquiry(form, reference, origin));
    const receipt = new URLSearchParams({ enviada: '1' });
    if (reference) receipt.set('equipo', reference);
    if (origin) receipt.set('origen', origin);
    return Astro.redirect('/consulta?' + receipt, 303);
  } catch (failure) {
    if (!(failure instanceof FormError)) console.error(failure);
    error = failure instanceof FormError ? failure.message : 'No se pudo guardar la consulta. Probá de nuevo.';
    Astro.response.status = failure instanceof FormError ? failure.status : 500;
  }
}
const sent = Astro.url.searchParams.get('enviada') === '1';
const machine = reference ? findPublicEquipment(reference) : null;
const photo = machine && getPhotos(machine)[0];
const unavailable = Boolean(reference && !machine && !sent);
if (unavailable && !error) Astro.response.status = 404;
const value = (field: string) => text(form, field, 1200);
const specifications = machine && [
  [machine.brand, machine.model].filter(Boolean).join(' '),
  machine.capacity, machine.format_detail || (machine.format !== 'otros' && formats[machine.format]),
  conditions[machine.condition], machine.province,
].filter(Boolean).join(' · ');
---
<Layout title={machine ? 'Consultar por ' + machine.title : 'Pedir un equipo'} page={reference ? 'consulta-equipo' : 'consulta'}>
  <div class="wrap interior form-interior">
    <a class="back-link" href={(machine ? `/equipos/${machine.ref}` : '/') + sourceQuery}><Icon name="back" size={18} />{machine ? 'Volver a la ficha' : 'Volver al catálogo'}</a>
    <header class="page-heading"><h1>{sent ? 'Consulta enviada' : unavailable ? 'Equipo no disponible' : machine ? 'Consultá por este equipo' : '¿Qué equipo necesitás?'}</h1>
      {!sent && !unavailable && !machine && <p>Contanos qué querés envasar, qué capacidad buscás y en qué provincia estás.</p>}
    </header>
    {machine && <section class="inquiry-equipment" aria-labelledby="inquiry-equipment-title">
      {photo && <img src={photo} alt="" width="100" height="100" />}
      <div>
        <p class="inquiry-reference">{categories[machine.category]} · {machine.ref}</p>
        <h2 id="inquiry-equipment-title">{machine.title}</h2>
        {specifications && <p>{specifications}</p>}
        {machine.reference ? <p>Ficha de referencia. Podemos buscar este modelo o uno similar.</p> : <strong>{priceLabel(machine)}</strong>}
      </div>
    </section>}
    <div class="form-card">
    {sent ? <><p class="message" role="status">Recibimos tu consulta. El equipo de Agua Máquinas podrá contactarte para seguirla.</p><a class="button button-primary" href={'/' + sourceQuery}>Volver al catálogo</a></> : unavailable ? <>
        <p class="message">Dejanos un pedido y contanos qué máquina buscás.</p>
        <a class="button button-primary" href={'/consulta' + sourceQuery}>Pedir un equipo</a>
      </> : <>
        {error && <p class="message message-error" role="alert">{error}</p>}
        <form class="form-stack" method="post" data-astro-reload>
          <label>Tu nombre<input name="name" required maxlength="80" autocomplete="name" value={text(form, 'name', 80)} /></label>
          <div class="field-grid">
            <label>WhatsApp<input name="whatsapp" type="tel" required maxlength="30" autocomplete="tel" placeholder="Ej. +54 9 11 1234 5678" value={value('whatsapp')} /></label>
            <label>Correo electrónico<input name="email" type="email" required maxlength="254" autocomplete="email" value={value('email')} /></label>
          </div>
          <label>{machine ? 'Mensaje' : '¿Qué equipo buscás?'}{machine && <small>Opcional</small>}
            <textarea name="message" required={!machine} maxlength="1200"
              placeholder={machine ? 'Podés pedir un video, coordinar una visita o contarnos si buscás un equipo similar.' : 'Ej. Busco una llenadora para bidones de 20 L en Córdoba.'}>{value('message')}</textarea>
          </label>
          {machine ? <details class="inquiry-purchase" open={Boolean(value('location') || value('budget') || value('timeframe'))}>
            <summary>Agregar datos de la compra <small>Opcional</small></summary>
            <div class="field-grid"><InquiryCriteria value={value} /></div>
          </details> : <fieldset><legend>Datos de la compra</legend>
            <div class="field-grid"><InquiryCriteria value={value} publicForm /></div>
          </fieldset>}
          <p class="field-hint">Usamos tu WhatsApp y correo para responderte.</p>
          <button class="button button-primary" type="submit">Enviar consulta <Icon name="arrow" size={18} /></button>
        </form>
      </>}
    </div>
  </div>
</Layout>

<style>
  .inquiry-equipment {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .inquiry-equipment img { flex: 0 0 auto; width: 100px; height: 100px; object-fit: contain; background: var(--subtle); border-radius: var(--radius); }
  .inquiry-equipment > div { min-width: 0; }
  .inquiry-equipment h2 { margin: 2px 0 4px; font-size: 1.25rem; line-height: 1.25; font-weight: 750; overflow-wrap: anywhere; }
  .inquiry-equipment p { font-size: .875rem; color: var(--muted); }
  .inquiry-equipment .inquiry-reference { font-size: .8125rem; font-weight: 600; }
  .inquiry-equipment strong { display: inline-block; margin-top: 4px; }
  .inquiry-purchase { padding-block: 10px; border-block: 1px solid var(--line); }
  .inquiry-purchase summary { cursor: pointer; color: var(--deep); font-weight: 650; }
  .inquiry-purchase summary small { margin-inline-start: 4px; }
  .inquiry-purchase[open] .field-grid { margin-top: 12px; }
  @media (max-width: 520px) {
    .inquiry-equipment { align-items: flex-start; padding: 12px; gap: 12px; }
    .inquiry-equipment img { width: 64px; height: 64px; }
    .inquiry-equipment h2 { font-size: 1.05rem; }
  }
</style>
